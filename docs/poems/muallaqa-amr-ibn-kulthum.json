      "title": "ألا هبي بصحنك فاصبحينا",
      "number": 1
    }
  ],
  "verses": [
    {
      "id": "muallaqa-amr-ibn-kulthum-001",
      "number": 1,
      "first_hemistich": "أَلاَ هُبِّي بِصَحْنِكِ فَاصْبَحِيْنَا",
      "second_hemistich": "وَلاَ تُبْقِي خُمُوْرَ الأَنْدَرِيْنَا",
      "text": "أَلاَ هُبِّي بِصَحْنِكِ فَاصْبَحِيْنَا\nوَلاَ تُبْقِي خُمُوْرَ الأَنْدَرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-002",
      "number": 2,
      "first_hemistich": "مُشَعْشَعَةً كَأَنَّ الحُصَّ فِيْهَا",
      "second_hemistich": "إِذَا مَا المَاءَ خَالَطَهَا سَخِيْنَا",
      "text": "مُشَعْشَعَةً كَأَنَّ الحُصَّ فِيْهَا\nإِذَا مَا المَاءَ خَالَطَهَا سَخِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-003",
      "number": 3,
      "first_hemistich": "تَجُوْرُ بِذِي اللَّبَانَةِ عَنْ هَوَاهُ",
      "second_hemistich": "إِذَا مَا ذَاقَهَا حَتَّى يَلِيْنَا",
      "text": "تَجُوْرُ بِذِي اللَّبَانَةِ عَنْ هَوَاهُ\nإِذَا مَا ذَاقَهَا حَتَّى يَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-004",
      "number": 4,
      "first_hemistich": "تَرَى اللَّحِزَ الشَّحِيْحَ إِذَا أُمِرَّتْ",
      "second_hemistich": "عَلَيْهِ لِمَالِهِ فِيْهَا مُهِيْنَا",
      "text": "تَرَى اللَّحِزَ الشَّحِيْحَ إِذَا أُمِرَّتْ\nعَلَيْهِ لِمَالِهِ فِيْهَا مُهِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-005",
      "number": 5,
      "first_hemistich": "صَدَدْتِ الكَأْسَ عَنَّا أُمَّ عَمْرٍو",
      "second_hemistich": "وَكَانَ الكَأْسُ مَجْرَاهَا اليَمِيْنَا",
      "text": "صَدَدْتِ الكَأْسَ عَنَّا أُمَّ عَمْرٍو\nوَكَانَ الكَأْسُ مَجْرَاهَا اليَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-006",
      "number": 6,
      "first_hemistich": "وَمَا شَرُّ الثَّلاَثَةِ أُمَّ عَمْرٍو",
      "second_hemistich": "بِصَاحِبِكِ الذِي لاَ تَصْبَحِيْنَا",
      "text": "وَمَا شَرُّ الثَّلاَثَةِ أُمَّ عَمْرٍو\nبِصَاحِبِكِ الذِي لاَ تَصْبَحِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-007",
      "number": 7,
      "first_hemistich": "وَكَأْسٍ قَدْ شَرِبْتُ بِبَعْلَبَكٍّ",
      "second_hemistich": "وَأُخْرَى فِي دِمَشْقَ وَقَاصرِيْنَا",
      "text": "وَكَأْسٍ قَدْ شَرِبْتُ بِبَعْلَبَكٍّ\nوَأُخْرَى فِي دِمَشْقَ وَقَاصرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-008",
      "number": 8,
      "first_hemistich": "وَإِنَّا سَوْفَ تُدْرِكُنَا المَنَايَا",
      "second_hemistich": "مُقَدَّرَةً لَنَا وَمُقَدِّرِيْنَا",
      "text": "وَإِنَّا سَوْفَ تُدْرِكُنَا المَنَايَا\nمُقَدَّرَةً لَنَا وَمُقَدِّرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-009",
      "number": 9,
      "first_hemistich": "قِفِي قَبْلَ التَّفَرُّقِ يَا ظَعِيْنَا",
      "second_hemistich": "نُخَبِّرْكِ اليَقِيْنَ وَتُخْبِرِيْنَا",
      "text": "قِفِي قَبْلَ التَّفَرُّقِ يَا ظَعِيْنَا\nنُخَبِّرْكِ اليَقِيْنَ وَتُخْبِرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-010",
      "number": 10,
      "first_hemistich": "قِفِي نَسْأَلْكِ هَلْ أَحْدَثْتِ صَرْماً",
      "second_hemistich": "لِوَشْكِ البَيْنِ أَمْ خُنْتِ الأَمِيْنَا",
      "text": "قِفِي نَسْأَلْكِ هَلْ أَحْدَثْتِ صَرْماً\nلِوَشْكِ البَيْنِ أَمْ خُنْتِ الأَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-011",
      "number": 11,
      "first_hemistich": "بِيَوْمِ كَرِيْهَةٍ ضَرْباً وَطَعناً",
      "second_hemistich": "أَقَرَّ بِهِ مَوَالِيْكِ العُيُوْنَا",
      "text": "بِيَوْمِ كَرِيْهَةٍ ضَرْباً وَطَعناً\nأَقَرَّ بِهِ مَوَالِيْكِ العُيُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-012",
      "number": 12,
      "first_hemistich": "وَأنَّ غَداً وَأنَّ اليَوْمَ رَهْنٌ",
      "second_hemistich": "وَبَعْدَ غَدٍ بِمَا لاَ تَعْلَمِيْنَا",
      "text": "وَأنَّ غَداً وَأنَّ اليَوْمَ رَهْنٌ\nوَبَعْدَ غَدٍ بِمَا لاَ تَعْلَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-013",
      "number": 13,
      "first_hemistich": "تُرِيْكَ إِذَا دَخَلَتْ عَلَى خَلاَءٍ",
      "second_hemistich": "وَقَدْ أَمِنْتَ عُيُوْنَ الكَاشِحِيْنَا",
      "text": "تُرِيْكَ إِذَا دَخَلَتْ عَلَى خَلاَءٍ\nوَقَدْ أَمِنْتَ عُيُوْنَ الكَاشِحِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-014",
      "number": 14,
      "first_hemistich": "ذِرَاعِي عَيْطَلٍ أَدَمَاءَ بِكْرٍ",
      "second_hemistich": "هِجَانِ اللَّوْنِ لَمْ تَقْرَأ جَنِيْنَا",
      "text": "ذِرَاعِي عَيْطَلٍ أَدَمَاءَ بِكْرٍ\nهِجَانِ اللَّوْنِ لَمْ تَقْرَأ جَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-015",
      "number": 15,
      "first_hemistich": "وثَدْياً مِثْلَ حُقِّ العَاجِ رَخِصاً",
      "second_hemistich": "حَصَاناً مِنْ أُكُفِّ اللاَمِسِيْنَا",
      "text": "وثَدْياً مِثْلَ حُقِّ العَاجِ رَخِصاً\nحَصَاناً مِنْ أُكُفِّ اللاَمِسِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-016",
      "number": 16,
      "first_hemistich": "ومَتْنَى لَدِنَةٍ سَمَقَتْ وطَالَتْ",
      "second_hemistich": "رَوَادِفُهَا تَنوءُ بِمَا وَلِيْنَا",
      "text": "ومَتْنَى لَدِنَةٍ سَمَقَتْ وطَالَتْ\nرَوَادِفُهَا تَنوءُ بِمَا وَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-017",
      "number": 17,
      "first_hemistich": "وَمأْكَمَةً يَضِيقُ البَابُ عَنْهَا",
      "second_hemistich": "وكَشْحاً قَد جُنِنْتُ بِهِ جُنُونَا",
      "text": "وَمأْكَمَةً يَضِيقُ البَابُ عَنْهَا\nوكَشْحاً قَد جُنِنْتُ بِهِ جُنُونَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-018",
      "number": 18,
      "first_hemistich": "وسَارِيَتِي بَلَنْطٍ أَو رُخَامٍ",
      "second_hemistich": "يَرِنُّ خَشَاشُ حَلِيهِمَا رَنِيْنَا",
      "text": "وسَارِيَتِي بَلَنْطٍ أَو رُخَامٍ\nيَرِنُّ خَشَاشُ حَلِيهِمَا رَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-019",
      "number": 19,
      "first_hemistich": "فَمَا وَجَدَتْ كَوَجْدِي أُمُّ سَقبٍ",
      "second_hemistich": "أَضَلَّتْهُ فَرَجَّعتِ الحَنِيْنَا",
      "text": "فَمَا وَجَدَتْ كَوَجْدِي أُمُّ سَقبٍ\nأَضَلَّتْهُ فَرَجَّعتِ الحَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-020",
      "number": 20,
      "first_hemistich": "ولاَ شَمْطَاءُ لَم يَتْرُك شَقَاهَا",
      "second_hemistich": "لَها مِن تِسْعَةٍ إلاَّ جَنِيْنَا",
      "text": "ولاَ شَمْطَاءُ لَم يَتْرُك شَقَاهَا\nلَها مِن تِسْعَةٍ إلاَّ جَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-021",
      "number": 21,
      "first_hemistich": "تَذَكَّرْتُ الصِّبَا وَاشْتَقْتُ لَمَّا",
      "second_hemistich": "رَأَيْتُ حُمُوْلَهَا أصُلاً حُدِيْنَا",
      "text": "تَذَكَّرْتُ الصِّبَا وَاشْتَقْتُ لَمَّا\nرَأَيْتُ حُمُوْلَهَا أصُلاً حُدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-022",
      "number": 22,
      "first_hemistich": "فَأَعْرَضَتِ اليَمَامَةُ وَاشْمَخَرَّتْ",
      "second_hemistich": "كَأَسْيَافٍ بِأَيْدِي مُصْلِتِيْنَا",
      "text": "فَأَعْرَضَتِ اليَمَامَةُ وَاشْمَخَرَّتْ\nكَأَسْيَافٍ بِأَيْدِي مُصْلِتِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-023",
      "number": 23,
      "first_hemistich": "أَبَا هِنْدٍ فَلاَ تَعْجَلْ عَلَيْنَا",
      "second_hemistich": "وَأَنْظِرْنَا نُخَبِّرْكَ اليَقِيْنَا",
      "text": "أَبَا هِنْدٍ فَلاَ تَعْجَلْ عَلَيْنَا\nوَأَنْظِرْنَا نُخَبِّرْكَ اليَقِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-024",
      "number": 24,
      "first_hemistich": "بِأَنَّا نُوْرِدُ الرَّايَاتِ بِيْضاً",
      "second_hemistich": "وَنُصْدِرُهُنَّ حُمْراً قَدْ رُوِيْنَا",
      "text": "بِأَنَّا نُوْرِدُ الرَّايَاتِ بِيْضاً\nوَنُصْدِرُهُنَّ حُمْراً قَدْ رُوِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-025",
      "number": 25,
      "first_hemistich": "وَأَيَّامٍ لَنَا غُرٍّ طِوَالٍ",
      "second_hemistich": "عَصَيْنَا المَلِكَ فِيهَا أَنْ نَدِيْنَا",
      "text": "وَأَيَّامٍ لَنَا غُرٍّ طِوَالٍ\nعَصَيْنَا المَلِكَ فِيهَا أَنْ نَدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-026",
      "number": 26,
      "first_hemistich": "وَسَيِّدِ مَعْشَرٍ قَدْ تَوَّجُوْهُ",
      "second_hemistich": "بِتَاجِ المُلْكِ يَحْمِي المُحْجَرِيْنَا",
      "text": "وَسَيِّدِ مَعْشَرٍ قَدْ تَوَّجُوْهُ\nبِتَاجِ المُلْكِ يَحْمِي المُحْجَرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-027",
      "number": 27,
      "first_hemistich": "تَرَكْنَ الخَيْلَ عَاكِفَةً عَلَيْهِ",
      "second_hemistich": "مُقَلَّدَةً أَعِنَّتَهَا صُفُوْنَا",
      "text": "تَرَكْنَ الخَيْلَ عَاكِفَةً عَلَيْهِ\nمُقَلَّدَةً أَعِنَّتَهَا صُفُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-028",
      "number": 28,
      "first_hemistich": "وَأَنْزَلْنَا البُيُوْتَ بِذِي طُلُوْحٍ",
      "second_hemistich": "إِلَى الشَامَاتِ نَنْفِي المُوْعِدِيْنَا",
      "text": "وَأَنْزَلْنَا البُيُوْتَ بِذِي طُلُوْحٍ\nإِلَى الشَامَاتِ نَنْفِي المُوْعِدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-029",
      "number": 29,
      "first_hemistich": "وَقَدْ هَرَّتْ كِلاَبُ الحَيِّ مِنَّا",
      "second_hemistich": "وَشَذَّبْنَا قَتَادَةَ مَنْ يَلِيْنَا",
      "text": "وَقَدْ هَرَّتْ كِلاَبُ الحَيِّ مِنَّا\nوَشَذَّبْنَا قَتَادَةَ مَنْ يَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-030",
      "number": 30,
      "first_hemistich": "مَتَى نَنْقُلْ إِلَى قَوْمٍ رَحَانَا",
      "second_hemistich": "يَكُوْنُوا فِي اللِّقَاءِ لَهَا طَحِيْنَا",
      "text": "مَتَى نَنْقُلْ إِلَى قَوْمٍ رَحَانَا\nيَكُوْنُوا فِي اللِّقَاءِ لَهَا طَحِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-031",
      "number": 31,
      "first_hemistich": "يَكُوْنُ ثِقَالُهَا شَرْقِيَّ نَجْدٍ",
      "second_hemistich": "وَلُهْوَتُهَا قُضَاعَةَ أَجْمَعِيْنَا",
      "text": "يَكُوْنُ ثِقَالُهَا شَرْقِيَّ نَجْدٍ\nوَلُهْوَتُهَا قُضَاعَةَ أَجْمَعِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-032",
      "number": 32,
      "first_hemistich": "نَزَلْتُمْ مَنْزِلَ الأَضْيَافِ مِنَّا",
      "second_hemistich": "فَأَعْجَلْنَا القِرَى أَنْ تَشْتِمُوْنَا",
      "text": "نَزَلْتُمْ مَنْزِلَ الأَضْيَافِ مِنَّا\nفَأَعْجَلْنَا القِرَى أَنْ تَشْتِمُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-033",
      "number": 33,
      "first_hemistich": "قَرَيْنَاكُمْ فَعَجَّلْنَا قِرَاكُمْ",
      "second_hemistich": "قُبَيْلَ الصُّبْحِ مِرْدَاةً طَحُوْنَا",
      "text": "قَرَيْنَاكُمْ فَعَجَّلْنَا قِرَاكُمْ\nقُبَيْلَ الصُّبْحِ مِرْدَاةً طَحُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-034",
      "number": 34,
      "first_hemistich": "نَعُمُّ أُنَاسَنَا وَنَعِفُّ عَنْهُمْ",
      "second_hemistich": "وَنَحْمِلُ عَنْهُمُ مَا حَمَّلُوْنَا",
      "text": "نَعُمُّ أُنَاسَنَا وَنَعِفُّ عَنْهُمْ\nوَنَحْمِلُ عَنْهُمُ مَا حَمَّلُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-035",
      "number": 35,
      "first_hemistich": "نُطَاعِنُ مَا تَرَاخَى النَّاسُ عَنَّا",
      "second_hemistich": "وَنَضْرِبُ بِالسِّيُوْفِ إِذَا غُشِيْنَا",
      "text": "نُطَاعِنُ مَا تَرَاخَى النَّاسُ عَنَّا\nوَنَضْرِبُ بِالسِّيُوْفِ إِذَا غُشِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-036",
      "number": 36,
      "first_hemistich": "بِسُمْرٍ مِنْ قَنَا الخَطِّيِّ لُدْنٍ",
      "second_hemistich": "ذَوَابِلَ أَوْ بِبِيْضٍ يَخْتَلِيْنَا",
      "text": "بِسُمْرٍ مِنْ قَنَا الخَطِّيِّ لُدْنٍ\nذَوَابِلَ أَوْ بِبِيْضٍ يَخْتَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-037",
      "number": 37,
      "first_hemistich": "كَأَنَّ جَمَاجِمَ الأَبْطَالِ فِيْهَا",
      "second_hemistich": "وُسُوْقٌ بِالأَمَاعِزِ يَرْتَمِيْنَا",
      "text": "كَأَنَّ جَمَاجِمَ الأَبْطَالِ فِيْهَا\nوُسُوْقٌ بِالأَمَاعِزِ يَرْتَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-038",
      "number": 38,
      "first_hemistich": "نَشُقُّ بِهَا رُؤُوْسَ القَوْمِ شَقًّا",
      "second_hemistich": "وَنَخْتَلِبُ الرِّقَابَ فَتَخْتَلِيْنَا",
      "text": "نَشُقُّ بِهَا رُؤُوْسَ القَوْمِ شَقًّا\nوَنَخْتَلِبُ الرِّقَابَ فَتَخْتَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-039",
      "number": 39,
      "first_hemistich": "وَإِنَّ الضِّغْنَ بَعْدَ الضِّغْنِ يَبْدُو",
      "second_hemistich": "عَلَيْكَ وَيُخْرِجُ الدَّاءَ الدَّفِيْنَا",
      "text": "وَإِنَّ الضِّغْنَ بَعْدَ الضِّغْنِ يَبْدُو\nعَلَيْكَ وَيُخْرِجُ الدَّاءَ الدَّفِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-040",
      "number": 40,
      "first_hemistich": "وَرِثْنَا المَجْدَ قَدْ عَلِمَتْ مَعَدٌّ",
      "second_hemistich": "نُطَاعِنُ دُوْنَهُ حَتَّى يَبِيْنَا",
      "text": "وَرِثْنَا المَجْدَ قَدْ عَلِمَتْ مَعَدٌّ\nنُطَاعِنُ دُوْنَهُ حَتَّى يَبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-041",
      "number": 41,
      "first_hemistich": "وَنَحْنُ إِذَا عِمَادُ الحَيِّ خَرَّتْ",
      "second_hemistich": "عَنِ الأَحْفَاضِ نَمْنَعُ مَنْ يَلِيْنَا",
      "text": "وَنَحْنُ إِذَا عِمَادُ الحَيِّ خَرَّتْ\nعَنِ الأَحْفَاضِ نَمْنَعُ مَنْ يَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-042",
      "number": 42,
      "first_hemistich": "نَجُذُّ رُؤُوْسَهُمْ فِي غَيْرِ بِرٍّ",
      "second_hemistich": "فَمَا يَدْرُوْنَ مَاذَا يَتَّقُوْنَا",
      "text": "نَجُذُّ رُؤُوْسَهُمْ فِي غَيْرِ بِرٍّ\nفَمَا يَدْرُوْنَ مَاذَا يَتَّقُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-043",
      "number": 43,
      "first_hemistich": "كَأَنَّ سُيُوْفَنَا منَّا ومنْهُم",
      "second_hemistich": "مَخَارِيْقٌ بِأَيْدِي لاَعِبِيْنَا",
      "text": "كَأَنَّ سُيُوْفَنَا منَّا ومنْهُم\nمَخَارِيْقٌ بِأَيْدِي لاَعِبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-044",
      "number": 44,
      "first_hemistich": "كَأَنَّ ثِيَابَنَا مِنَّا وَمِنْهُمْ",
      "second_hemistich": "خُضِبْنَ بِأُرْجُوَانِ أَوْ طُلِيْنَا",
      "text": "كَأَنَّ ثِيَابَنَا مِنَّا وَمِنْهُمْ\nخُضِبْنَ بِأُرْجُوَانِ أَوْ طُلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-045",
      "number": 45,
      "first_hemistich": "إِذَا مَا عَيَّ بِالإِسْنَافِ حَيٌّ",
      "second_hemistich": "مِنَ الهَوْلِ المُشَبَّهِ أَنْ يَكُوْنَا",
      "text": "إِذَا مَا عَيَّ بِالإِسْنَافِ حَيٌّ\nمِنَ الهَوْلِ المُشَبَّهِ أَنْ يَكُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-046",
      "number": 46,
      "first_hemistich": "نَصَبْنَا مِثْلَ رَهْوَةِ ذَاتَ حَدٍّ",
      "second_hemistich": "مُحَافَظَةً وَكُنَّا السَّابِقِيْنَا",
      "text": "نَصَبْنَا مِثْلَ رَهْوَةِ ذَاتَ حَدٍّ\nمُحَافَظَةً وَكُنَّا السَّابِقِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-047",
      "number": 47,
      "first_hemistich": "بِشُبَّانٍ يَرَوْنَ القَتْلَ مَجْداً",
      "second_hemistich": "وَشِيْبٍ فِي الحُرُوْبِ مُجَرَّبِيْنَا",
      "text": "بِشُبَّانٍ يَرَوْنَ القَتْلَ مَجْداً\nوَشِيْبٍ فِي الحُرُوْبِ مُجَرَّبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-048",
      "number": 48,
      "first_hemistich": "حُدَيَّا النَّاسِ كُلِّهِمُ جَمِيْعاً",
      "second_hemistich": "مُقَارَعَةً بَنِيْهِمْ عَنْ بَنِيْنَا",
      "text": "حُدَيَّا النَّاسِ كُلِّهِمُ جَمِيْعاً\nمُقَارَعَةً بَنِيْهِمْ عَنْ بَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-049",
      "number": 49,
      "first_hemistich": "فَأَمَّا يَوْمَ خَشْيَتِنَا عَلَيْهِمْ",
      "second_hemistich": "فَتُصْبِحُ خَيْلُنَا عُصَباً ثُبِيْنَا",
      "text": "فَأَمَّا يَوْمَ خَشْيَتِنَا عَلَيْهِمْ\nفَتُصْبِحُ خَيْلُنَا عُصَباً ثُبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-050",
      "number": 50,
      "first_hemistich": "وَأَمَّا يَوْمَ لاَ نَخْشَى عَلَيْهِمْ",
      "second_hemistich": "فَنُمْعِنُ غَارَةً مُتَلَبِّبِيْنَا",
      "text": "وَأَمَّا يَوْمَ لاَ نَخْشَى عَلَيْهِمْ\nفَنُمْعِنُ غَارَةً مُتَلَبِّبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-051",
      "number": 51,
      "first_hemistich": "بِرَأْسٍ مِنْ بَنِي جُشْمٍ بِنْ بَكْرٍ",
      "second_hemistich": "نَدُقُّ بِهِ السُّهُوْلَةَ وَالحُزُوْنَا",
      "text": "بِرَأْسٍ مِنْ بَنِي جُشْمٍ بِنْ بَكْرٍ\nنَدُقُّ بِهِ السُّهُوْلَةَ وَالحُزُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-052",
      "number": 52,
      "first_hemistich": "أَلاَ لاَ يَعْلَمُ الأَقْوَامُ أَنَّا",
      "second_hemistich": "تَضَعْضَعْنَا وَأَنَّا قَدْ وَنِيْنَا",
      "text": "أَلاَ لاَ يَعْلَمُ الأَقْوَامُ أَنَّا\nتَضَعْضَعْنَا وَأَنَّا قَدْ وَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-053",
      "number": 53,
      "first_hemistich": "أَلاَ لاَ يَجْهَلَنَّ أَحَدٌ عَلَيْنَا",
      "second_hemistich": "فَنَجْهَلَ فَوْقَ جَهْلِ الجَاهِلِيْنَا",
      "text": "أَلاَ لاَ يَجْهَلَنَّ أَحَدٌ عَلَيْنَا\nفَنَجْهَلَ فَوْقَ جَهْلِ الجَاهِلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-054",
      "number": 54,
      "first_hemistich": "بِاَيِّ مَشِيْئَةٍ عَمْرُو بْنَ هِنْدٍ",
      "second_hemistich": "نَكُوْنُ لِقَيْلِكُمْ فِيْهَا قَطِيْنَا",
      "text": "بِاَيِّ مَشِيْئَةٍ عَمْرُو بْنَ هِنْدٍ\nنَكُوْنُ لِقَيْلِكُمْ فِيْهَا قَطِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-055",
      "number": 55,
      "first_hemistich": "بِأَيِّ مَشِيْئَةٍ عَمْرَو بْنَ هِنْدٍ",
      "second_hemistich": "تُطِيْعُ بِنَا الوُشَاةَ وَتَزْدَرِيْنَا",
      "text": "بِأَيِّ مَشِيْئَةٍ عَمْرَو بْنَ هِنْدٍ\nتُطِيْعُ بِنَا الوُشَاةَ وَتَزْدَرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-056",
      "number": 56,
      "first_hemistich": "تَهَدَّدُنَا وَتُوْعِدُنَا رُوَيْداً",
      "second_hemistich": "مَتَى كُنَّا لأُمِّكَ مَقْتَوِيْنَا",
      "text": "تَهَدَّدُنَا وَتُوْعِدُنَا رُوَيْداً\nمَتَى كُنَّا لأُمِّكَ مَقْتَوِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-057",
      "number": 57,
      "first_hemistich": "فَإِنَّ قَنَاتَنَا يَا عَمْرُو أَعْيَتْ",
      "second_hemistich": "عَلى الأَعْدَاءِ قَبَلَكَ أَنْ تَلِيْنَا",
      "text": "فَإِنَّ قَنَاتَنَا يَا عَمْرُو أَعْيَتْ\nعَلى الأَعْدَاءِ قَبَلَكَ أَنْ تَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-058",
      "number": 58,
      "first_hemistich": "إِذَا عَضَّ الثَّقَافُ بِهَا اشْمَأَزَّتْ",
      "second_hemistich": "وَوَلَّتْهُ عَشَوْزَنَةً زَبُوْنَا",
      "text": "إِذَا عَضَّ الثَّقَافُ بِهَا اشْمَأَزَّتْ\nوَوَلَّتْهُ عَشَوْزَنَةً زَبُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-059",
      "number": 59,
      "first_hemistich": "عَشَوْزَنَةً إِذَا انْقَلَبَتْ أَرَنَّت",
      "second_hemistich": "تَشُجُّ قَفَا المُثَقِّفِ وَالجَبِيْنَا",
      "text": "عَشَوْزَنَةً إِذَا انْقَلَبَتْ أَرَنَّت\nتَشُجُّ قَفَا المُثَقِّفِ وَالجَبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-060",
      "number": 60,
      "first_hemistich": "فَهَلْ حُدِّثْتَ فِي جُشَمٍ بِنْ بَكْرٍ",
      "second_hemistich": "بِنَقْصٍ فِي خُطُوْبِ الأَوَّلِيْنَا",
      "text": "فَهَلْ حُدِّثْتَ فِي جُشَمٍ بِنْ بَكْرٍ\nبِنَقْصٍ فِي خُطُوْبِ الأَوَّلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-061",
      "number": 61,
      "first_hemistich": "وَرِثْنَا مَجْدَ عَلْقَمَةَ بِنْ سَيْفٍ",
      "second_hemistich": "أَبَاحَ لَنَا حُصُوْنَ المَجْدِ دِيْنَا",
      "text": "وَرِثْنَا مَجْدَ عَلْقَمَةَ بِنْ سَيْفٍ\nأَبَاحَ لَنَا حُصُوْنَ المَجْدِ دِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-062",
      "number": 62,
      "first_hemistich": "وَرَثْتُ مُهَلْهِلاً وَالخَيْرَ مِنْهُ",
      "second_hemistich": "زُهَيْراً نِعْمَ ذُخْرُ الذَّاخِرِيْنَا",
      "text": "وَرَثْتُ مُهَلْهِلاً وَالخَيْرَ مِنْهُ\nزُهَيْراً نِعْمَ ذُخْرُ الذَّاخِرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-063",
      "number": 63,
      "first_hemistich": "وَعَتَّاباً وَكُلْثُوْماً جَمِيْعاً",
      "second_hemistich": "بِهِمْ نِلْنَا تُرَاثَ الأَكْرَمِيْنَا",
      "text": "وَعَتَّاباً وَكُلْثُوْماً جَمِيْعاً\nبِهِمْ نِلْنَا تُرَاثَ الأَكْرَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-064",
      "number": 64,
      "first_hemistich": "وَذَا البُرَةِ الذِي حُدِّثْتَ عَنْهُ",
      "second_hemistich": "بِهِ نُحْمَى وَنَحْمِي المُلتَجِينَا",
      "text": "وَذَا البُرَةِ الذِي حُدِّثْتَ عَنْهُ\nبِهِ نُحْمَى وَنَحْمِي المُلتَجِينَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-065",
      "number": 65,
      "first_hemistich": "وَمِنَّا قَبْلَهُ السَّاعِي كُلَيْبٌ",
      "second_hemistich": "فَأَيُّ المَجْدِ إِلاَّ قَدْ وَلِيْنَا",
      "text": "وَمِنَّا قَبْلَهُ السَّاعِي كُلَيْبٌ\nفَأَيُّ المَجْدِ إِلاَّ قَدْ وَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-066",
      "number": 66,
      "first_hemistich": "مَتَى نَعْقِد قَرِيْنَتَنَا بِحَبْلٍ",
      "second_hemistich": "تَجُذَّ الحَبْلَ أَوْ تَقْصِ القَرِيْنَا",
      "text": "مَتَى نَعْقِد قَرِيْنَتَنَا بِحَبْلٍ\nتَجُذَّ الحَبْلَ أَوْ تَقْصِ القَرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-067",
      "number": 67,
      "first_hemistich": "وَنُوْجَدُ نَحْنُ أَمْنَعَهُمْ ذِمَاراً",
      "second_hemistich": "وَأَوْفَاهُمْ إِذَا عَقَدُوا يَمِيْنَا",
      "text": "وَنُوْجَدُ نَحْنُ أَمْنَعَهُمْ ذِمَاراً\nوَأَوْفَاهُمْ إِذَا عَقَدُوا يَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-068",
      "number": 68,
      "first_hemistich": "وَنَحْنُ غَدَاةَ أَوْقِدَ فِي خَزَازَى",
      "second_hemistich": "رَفَدْنَا فَوْقَ رِفْدِ الرَّافِدِيْنَا",
      "text": "وَنَحْنُ غَدَاةَ أَوْقِدَ فِي خَزَازَى\nرَفَدْنَا فَوْقَ رِفْدِ الرَّافِدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-069",
      "number": 69,
      "first_hemistich": "وَنَحْنُ الحَابِسُوْنَ بِذِي أَرَاطَى",
      "second_hemistich": "تَسَفُّ الجِلَّةُ الخُوْرُ الدَّرِيْنَا",
      "text": "وَنَحْنُ الحَابِسُوْنَ بِذِي أَرَاطَى\nتَسَفُّ الجِلَّةُ الخُوْرُ الدَّرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-070",
      "number": 70,
      "first_hemistich": "وَنَحْنُ الحَاكِمُوْنَ إِذَا أُطِعْنَا",
      "second_hemistich": "وَنَحْنُ العَازِمُوْنَ إِذَا عُصِيْنَا",
      "text": "وَنَحْنُ الحَاكِمُوْنَ إِذَا أُطِعْنَا\nوَنَحْنُ العَازِمُوْنَ إِذَا عُصِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-071",
      "number": 71,
      "first_hemistich": "وَنَحْنُ التَّارِكُوْنَ لِمَا سَخِطْنَا",
      "second_hemistich": "وَنَحْنُ الآخِذُوْنَ لِمَا رَضِيْنَا",
      "text": "وَنَحْنُ التَّارِكُوْنَ لِمَا سَخِطْنَا\nوَنَحْنُ الآخِذُوْنَ لِمَا رَضِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-072",
      "number": 72,
      "first_hemistich": "وَكُنَّا الأَيْمَنِيْنَ إِذَا التَقَيْنَا",
      "second_hemistich": "وَكَانَ الأَيْسَرِيْنَ بَنُو أَبَيْنَا",
      "text": "وَكُنَّا الأَيْمَنِيْنَ إِذَا التَقَيْنَا\nوَكَانَ الأَيْسَرِيْنَ بَنُو أَبَيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-073",
      "number": 73,
      "first_hemistich": "فَصَالُوا صَوْلَةً فِيْمَنْ يَلِيْهِمْ",
      "second_hemistich": "وَصُلْنَا صَوْلَةً فِيْمَنْ يَلِيْنَا",
      "text": "فَصَالُوا صَوْلَةً فِيْمَنْ يَلِيْهِمْ\nوَصُلْنَا صَوْلَةً فِيْمَنْ يَلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-074",
      "number": 74,
      "first_hemistich": "فَآبُوا بِالنِّهَابِ وَبِالسَّبَايَا",
      "second_hemistich": "وَأُبْنَا بِالمُلُوْكِ مُصَفَّدِيْنَا",
      "text": "فَآبُوا بِالنِّهَابِ وَبِالسَّبَايَا\nوَأُبْنَا بِالمُلُوْكِ مُصَفَّدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-075",
      "number": 75,
      "first_hemistich": "إِلَيْكُمْ يَا بَنِي بَكْرٍ إِلَيْكُمْ",
      "second_hemistich": "أَلَمَّا تَعْرِفُوا مِنَّا اليَقِيْنَا",
      "text": "إِلَيْكُمْ يَا بَنِي بَكْرٍ إِلَيْكُمْ\nأَلَمَّا تَعْرِفُوا مِنَّا اليَقِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-076",
      "number": 76,
      "first_hemistich": "أَلَمَّا تَعْلَمُوا مِنَّا وَمِنْكُمْ",
      "second_hemistich": "كَتَائِبَ يَطَّعِنَّ وَيَرْتَمِيْنَا",
      "text": "أَلَمَّا تَعْلَمُوا مِنَّا وَمِنْكُمْ\nكَتَائِبَ يَطَّعِنَّ وَيَرْتَمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-077",
      "number": 77,
      "first_hemistich": "عَلَيْنَا البَيْضُ وَاليَلَبُ اليَمَانِي",
      "second_hemistich": "وَأسْيَافٌ يَقُمْنَ وَيَنْحَنِيْنَا",
      "text": "عَلَيْنَا البَيْضُ وَاليَلَبُ اليَمَانِي\nوَأسْيَافٌ يَقُمْنَ وَيَنْحَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-078",
      "number": 78,
      "first_hemistich": "عَلَيْنَا كُلُّ سَابِغَةٍ دِلاَصٍ",
      "second_hemistich": "تَرَى فَوْقَ النِّطَاقِ لَهَا غُضُوْنَا",
      "text": "عَلَيْنَا كُلُّ سَابِغَةٍ دِلاَصٍ\nتَرَى فَوْقَ النِّطَاقِ لَهَا غُضُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-079",
      "number": 79,
      "first_hemistich": "إِذَا وَضِعَتْ عَنِ الأَبْطَالِ يَوْماً",
      "second_hemistich": "رَأَيْتَ لَهَا جُلُوْدَ القَوْمِ جُوْنَا",
      "text": "إِذَا وَضِعَتْ عَنِ الأَبْطَالِ يَوْماً\nرَأَيْتَ لَهَا جُلُوْدَ القَوْمِ جُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-080",
      "number": 80,
      "first_hemistich": "كَأَنَّ غُضُوْنَهُنَّ مُتُوْنُ غُدْرٍ",
      "second_hemistich": "تُصَفِّقُهَا الرِّيَاحُ إِذَا جَرَيْنَا",
      "text": "كَأَنَّ غُضُوْنَهُنَّ مُتُوْنُ غُدْرٍ\nتُصَفِّقُهَا الرِّيَاحُ إِذَا جَرَيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-081",
      "number": 81,
      "first_hemistich": "وَتَحْمِلُنَا غَدَاةَ الرَّوْعِ جُرْدٌ",
      "second_hemistich": "عُرِفْنَ لَنَا نَقَائِذَ وَافْتُلِيْنَا",
      "text": "وَتَحْمِلُنَا غَدَاةَ الرَّوْعِ جُرْدٌ\nعُرِفْنَ لَنَا نَقَائِذَ وَافْتُلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-082",
      "number": 82,
      "first_hemistich": "وَرَدْنَ دَوَارِعاً وَخَرَجْنَ شُعْثاً",
      "second_hemistich": "كَأَمْثَالِ الرِّصَائِعِ قَدْ بَلَيْنَا",
      "text": "وَرَدْنَ دَوَارِعاً وَخَرَجْنَ شُعْثاً\nكَأَمْثَالِ الرِّصَائِعِ قَدْ بَلَيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-083",
      "number": 83,
      "first_hemistich": "وَرِثْنَاهُنَّ عَنْ آبَاءِ صِدْقٍ",
      "second_hemistich": "وَنُوْرِثُهَا إِذَا مُتْنَا بَنِيْنَا",
      "text": "وَرِثْنَاهُنَّ عَنْ آبَاءِ صِدْقٍ\nوَنُوْرِثُهَا إِذَا مُتْنَا بَنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-084",
      "number": 84,
      "first_hemistich": "عَلَى آثَارِنَا بِيْضٌ حِسَانٌ",
      "second_hemistich": "نُحَاذِرُ أَنْ تُقَسَّمَ أَوْ تَهُوْنَا",
      "text": "عَلَى آثَارِنَا بِيْضٌ حِسَانٌ\nنُحَاذِرُ أَنْ تُقَسَّمَ أَوْ تَهُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-085",
      "number": 85,
      "first_hemistich": "أَخَذْنَ عَلَى بُعُوْلَتِهِنَّ عَهْداً",
      "second_hemistich": "إِذَا لاَقَوْا كَتَائِبَ مُعْلِمِيْنَا",
      "text": "أَخَذْنَ عَلَى بُعُوْلَتِهِنَّ عَهْداً\nإِذَا لاَقَوْا كَتَائِبَ مُعْلِمِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-086",
      "number": 86,
      "first_hemistich": "لَيَسْتَلِبُنَّ أَفْرَاساً وَبِيْضاً",
      "second_hemistich": "وَأَسْرَى فِي الحَدِيْدِ مُقَرَّنِيْنَا",
      "text": "لَيَسْتَلِبُنَّ أَفْرَاساً وَبِيْضاً\nوَأَسْرَى فِي الحَدِيْدِ مُقَرَّنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-087",
      "number": 87,
      "first_hemistich": "تَرَانَا بَارِزِيْنَ وَكُلُّ حَيٍّ",
      "second_hemistich": "قَدْ اتَّخَذُوا مَخَافَتَنَا قَرِيْناً",
      "text": "تَرَانَا بَارِزِيْنَ وَكُلُّ حَيٍّ\nقَدْ اتَّخَذُوا مَخَافَتَنَا قَرِيْناً",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-088",
      "number": 88,
      "first_hemistich": "إِذَا مَا رُحْنَ يَمْشِيْنَ الهُوَيْنَا",
      "second_hemistich": "كَمَا اضْطَرَبَتْ مُتُوْنُ الشَّارِبِيْنَا",
      "text": "إِذَا مَا رُحْنَ يَمْشِيْنَ الهُوَيْنَا\nكَمَا اضْطَرَبَتْ مُتُوْنُ الشَّارِبِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-089",
      "number": 89,
      "first_hemistich": "يَقُتْنَ جِيَادَنَا وَيَقُلْنَ لَسْتُمْ",
      "second_hemistich": "بُعُوْلَتَنَا إِذَا لَمْ تَمْنَعُوْنَا",
      "text": "يَقُتْنَ جِيَادَنَا وَيَقُلْنَ لَسْتُمْ\nبُعُوْلَتَنَا إِذَا لَمْ تَمْنَعُوْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-090",
      "number": 90,
      "first_hemistich": "ظَعَائِنَ مِنْ بَنِي جُشَمِ بِنْ بِكْرٍ",
      "second_hemistich": "خَلَطْنَ بِمِيْسَمٍ حَسَباً وَدِيْنَا",
      "text": "ظَعَائِنَ مِنْ بَنِي جُشَمِ بِنْ بِكْرٍ\nخَلَطْنَ بِمِيْسَمٍ حَسَباً وَدِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-091",
      "number": 91,
      "first_hemistich": "وَمَا مَنَعَ الظَّعَائِنَ مِثْلُ ضَرْبٍ",
      "second_hemistich": "تَرَى مِنْهُ السَّوَاعِدَ كَالقُلِيْنَا",
      "text": "وَمَا مَنَعَ الظَّعَائِنَ مِثْلُ ضَرْبٍ\nتَرَى مِنْهُ السَّوَاعِدَ كَالقُلِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-092",
      "number": 92,
      "first_hemistich": "كَأَنَّا وَالسُّيُوْفُ مُسَلَّلاَتٌ",
      "second_hemistich": "وَلَدْنَا النَّاسَ طُرّاً أَجْمَعِيْنَا",
      "text": "كَأَنَّا وَالسُّيُوْفُ مُسَلَّلاَتٌ\nوَلَدْنَا النَّاسَ طُرّاً أَجْمَعِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-093",
      "number": 93,
      "first_hemistich": "يُدَهْدِهنَ الرُّؤُوسِ كَمَا تُدَهْدَي",
      "second_hemistich": "حَزَاوِرَةٌ بِأَبطَحِهَا الكُرِيْنَا",
      "text": "يُدَهْدِهنَ الرُّؤُوسِ كَمَا تُدَهْدَي\nحَزَاوِرَةٌ بِأَبطَحِهَا الكُرِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-094",
      "number": 94,
      "first_hemistich": "وَقَدْ عَلِمَ القَبَائِلُ مِنْ مَعَدٍّ",
      "second_hemistich": "إِذَا قُبَبٌ بِأَبطَحِهَا بُنِيْنَا",
      "text": "وَقَدْ عَلِمَ القَبَائِلُ مِنْ مَعَدٍّ\nإِذَا قُبَبٌ بِأَبطَحِهَا بُنِيْنَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-amr-ibn-kulthum-095",
      "number": 95,
