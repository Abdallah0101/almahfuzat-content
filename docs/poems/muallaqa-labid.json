      "id": "qasida",
      "title": "عفت الديار محلها فمقامها",
      "number": 1
    }
  ],
  "verses": [
    {
      "id": "muallaqa-labid-001",
      "number": 1,
      "first_hemistich": "عفتِ الديارُ محلُّها فمُقامُهَا",
      "second_hemistich": "بمنًى تأبَّدَ غَوْلُها فَرِجَامُهَا",
      "text": "عفتِ الديارُ محلُّها فمُقامُهَا\nبمنًى تأبَّدَ غَوْلُها فَرِجَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-002",
      "number": 2,
      "first_hemistich": "فمدافعُ الرَّيَّانِ عرِّيَ رسْمُها",
      "second_hemistich": "خلقاً كما ضَمِنَ الوُحِيَّ سِلامُها",
      "text": "فمدافعُ الرَّيَّانِ عرِّيَ رسْمُها\nخلقاً كما ضَمِنَ الوُحِيَّ سِلامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-003",
      "number": 3,
      "first_hemistich": "دمِنٌ تَجَرَّمَ بعدَ عَهْدِ أنِيسِهَا",
      "second_hemistich": "حِجَجٌ خَلَوْنَ حَلالُهَا وحَرَامُهَا",
      "text": "دمِنٌ تَجَرَّمَ بعدَ عَهْدِ أنِيسِهَا\nحِجَجٌ خَلَوْنَ حَلالُهَا وحَرَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-004",
      "number": 4,
      "first_hemistich": "رزقَتْ مرابيعَ النُّجومِ وصابَهَا",
      "second_hemistich": "ودقُ الرواعدِ جوْدُهَا فرهامُها",
      "text": "رزقَتْ مرابيعَ النُّجومِ وصابَهَا\nودقُ الرواعدِ جوْدُهَا فرهامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-005",
      "number": 5,
      "first_hemistich": "منْ كلِّ سَارِيَةٍ وغادٍ مُدْجِنٍ",
      "second_hemistich": "وعشيَّةٍ متجاوبٍ إرْزامُهَا",
      "text": "منْ كلِّ سَارِيَةٍ وغادٍ مُدْجِنٍ\nوعشيَّةٍ متجاوبٍ إرْزامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-006",
      "number": 6,
      "first_hemistich": "فَعَلا فُرُوعُ الأيْهُقَانِ وَأطْفَلَتْ",
      "second_hemistich": "بالجلهتين ظباؤهَا ونعامُها",
      "text": "فَعَلا فُرُوعُ الأيْهُقَانِ وَأطْفَلَتْ\nبالجلهتين ظباؤهَا ونعامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-007",
      "number": 7,
      "first_hemistich": "والعينُ ساكِنةٌ على أطْلائِها",
      "second_hemistich": "عُوذاً تَأجَّلُ بالفضَاءِ بِهَامُها",
      "text": "والعينُ ساكِنةٌ على أطْلائِها\nعُوذاً تَأجَّلُ بالفضَاءِ بِهَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-008",
      "number": 8,
      "first_hemistich": "وجَلا السُّيولُ عن الطّلُولِ كأنّها",
      "second_hemistich": "زبرٌ تجِدُّ متونَها أقْلامُها",
      "text": "وجَلا السُّيولُ عن الطّلُولِ كأنّها\nزبرٌ تجِدُّ متونَها أقْلامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-009",
      "number": 9,
      "first_hemistich": "أوْ رَجْعُ واشِمةٍ أُسِفَّ نَؤورُهَا",
      "second_hemistich": "كففاً تعرَّضَ فوقَهنَّ وشامُها",
      "text": "أوْ رَجْعُ واشِمةٍ أُسِفَّ نَؤورُهَا\nكففاً تعرَّضَ فوقَهنَّ وشامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-010",
      "number": 10,
      "first_hemistich": "فوقفتُ أسْألُهَا،وكيفَ سُؤالُنَا",
      "second_hemistich": "صُمّاً خوالدَ ما يُبينُ كلامُها",
      "text": "فوقفتُ أسْألُهَا،وكيفَ سُؤالُنَا\nصُمّاً خوالدَ ما يُبينُ كلامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-011",
      "number": 11,
      "first_hemistich": "عرِيتْ وكان بها الجميعُ فأبكرُوا",
      "second_hemistich": "منها وَغُودرَ نُؤيُهَا وَثُمَامُها",
      "text": "عرِيتْ وكان بها الجميعُ فأبكرُوا\nمنها وَغُودرَ نُؤيُهَا وَثُمَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-012",
      "number": 12,
      "first_hemistich": "شاقتكَ ظُعْنُ الحيِّ حينَ تحمّلُوا",
      "second_hemistich": "فتكنَّسُوا قُطُناً تَصِرُّ خِيَامُها",
      "text": "شاقتكَ ظُعْنُ الحيِّ حينَ تحمّلُوا\nفتكنَّسُوا قُطُناً تَصِرُّ خِيَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-013",
      "number": 13,
      "first_hemistich": "من كلِّ مَحْفُوفٍ يُظِلُّ عِصِيَّهُ",
      "second_hemistich": "زوْجٌ عليه كلَّةٌ وقرامُهَا",
      "text": "من كلِّ مَحْفُوفٍ يُظِلُّ عِصِيَّهُ\nزوْجٌ عليه كلَّةٌ وقرامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-014",
      "number": 14,
      "first_hemistich": "زُجَلاً كأنَّ نِعَاجَ تُوضِحَ فَوْقَهَا",
      "second_hemistich": "وظِباءَ وجرَةَ عُطَّفاً آرَامُهَا",
      "text": "زُجَلاً كأنَّ نِعَاجَ تُوضِحَ فَوْقَهَا\nوظِباءَ وجرَةَ عُطَّفاً آرَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-015",
      "number": 15,
      "first_hemistich": "حُفِزَتْ وَزَايَلَهَا السَّرَابُ كأنها",
      "second_hemistich": "أجْزَاعُ بِيشة َ أثْلُهَا وَرُضَامُهَا",
      "text": "حُفِزَتْ وَزَايَلَهَا السَّرَابُ كأنها\nأجْزَاعُ بِيشة َ أثْلُهَا وَرُضَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-016",
      "number": 16,
      "first_hemistich": "بلْ ما تذكرُ منْ نوارَ وقد نأتْ",
      "second_hemistich": "وَتَقَطَّعَتْ أسْبَابُهَا وَرِمَامُهَا",
      "text": "بلْ ما تذكرُ منْ نوارَ وقد نأتْ\nوَتَقَطَّعَتْ أسْبَابُهَا وَرِمَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-017",
      "number": 17,
      "first_hemistich": "مُرِّيَّة ٌ حَلَّتْ بِفَيْدَ وَجَاوَرَتْ",
      "second_hemistich": "أهْلَ الحِجَازِ فأيْنَ مِنْكَ مَرَامُهَا",
      "text": "مُرِّيَّة ٌ حَلَّتْ بِفَيْدَ وَجَاوَرَتْ\nأهْلَ الحِجَازِ فأيْنَ مِنْكَ مَرَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-018",
      "number": 18,
      "first_hemistich": "بمشارقِ الجبلين أو بِمُحَجَّرٍ",
      "second_hemistich": "فَتَضَمَّنَتْهَا فَرْدَة ٌ فَرُخَامُهَا",
      "text": "بمشارقِ الجبلين أو بِمُحَجَّرٍ\nفَتَضَمَّنَتْهَا فَرْدَة ٌ فَرُخَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-019",
      "number": 19,
      "first_hemistich": "فَصُوَائقٌ إنْ أيْمَنَتْ فَمَظِنَّةٌ",
      "second_hemistich": "فيها وحافُ القَهْرِ أوْ طِلْخامُهَا",
      "text": "فَصُوَائقٌ إنْ أيْمَنَتْ فَمَظِنَّةٌ\nفيها وحافُ القَهْرِ أوْ طِلْخامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-020",
      "number": 20,
      "first_hemistich": "فاقطعْ لُبانَةَ مَنْ تَعَرَّضَ وَصْلُهُ",
      "second_hemistich": "ولَشرُّ واصلِ خُلَّةٍ صَرَّامُها",
      "text": "فاقطعْ لُبانَةَ مَنْ تَعَرَّضَ وَصْلُهُ\nولَشرُّ واصلِ خُلَّةٍ صَرَّامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-021",
      "number": 21,
      "first_hemistich": "واحبُ المُجَامِلَ بالجزيلِ وصرمُهُ",
      "second_hemistich": "باقٍ إذا ضلعَتْ وزاغَ قوامُهَا",
      "text": "واحبُ المُجَامِلَ بالجزيلِ وصرمُهُ\nباقٍ إذا ضلعَتْ وزاغَ قوامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-022",
      "number": 22,
      "first_hemistich": "بِطَليحِ أسْفَارٍ تَرَكْنَ بقيَّةً",
      "second_hemistich": "منها فأحنقَ صُلْبُها وسنامُها",
      "text": "بِطَليحِ أسْفَارٍ تَرَكْنَ بقيَّةً\nمنها فأحنقَ صُلْبُها وسنامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-023",
      "number": 23,
      "first_hemistich": "وإذا تغالى لحمُها وتحسَّرتْ",
      "second_hemistich": "وتَقَطَّعَتْ بعد الكَلالِ خِدَامُهَا",
      "text": "وإذا تغالى لحمُها وتحسَّرتْ\nوتَقَطَّعَتْ بعد الكَلالِ خِدَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-024",
      "number": 24,
      "first_hemistich": "فلها هبابٌ في الزِّمامِ كأنَّها",
      "second_hemistich": "صهباءُ خَفَّ مع الجنوبِ جَهَامُها",
      "text": "فلها هبابٌ في الزِّمامِ كأنَّها\nصهباءُ خَفَّ مع الجنوبِ جَهَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-025",
      "number": 25,
      "first_hemistich": "أو ملمِعٌ وسقَتْ لأحقبَ لاحَهُ",
      "second_hemistich": "طَرْدُ الفُحول وَضَرْبُهَا وَكِدَامُهَا",
      "text": "أو ملمِعٌ وسقَتْ لأحقبَ لاحَهُ\nطَرْدُ الفُحول وَضَرْبُهَا وَكِدَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-026",
      "number": 26,
      "first_hemistich": "يعلوُ بها حدبُ الإكامِ مسحَّجٌ",
      "second_hemistich": "قَد رابَهُ عصيانُهَا ووحَامُها",
      "text": "يعلوُ بها حدبُ الإكامِ مسحَّجٌ\nقَد رابَهُ عصيانُهَا ووحَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-027",
      "number": 27,
      "first_hemistich": "بأحِزَّةِ الثَّلَبُوتِ يَرْبَأُ فَوْقَهَا",
      "second_hemistich": "قَفْر المَرَاقِبِ خَوْفُهَا آرامُهَا",
      "text": "بأحِزَّةِ الثَّلَبُوتِ يَرْبَأُ فَوْقَهَا\nقَفْر المَرَاقِبِ خَوْفُهَا آرامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-028",
      "number": 28,
      "first_hemistich": "حتى إذا سَلَخَا جُمَادَى ستَّةً",
      "second_hemistich": "جَزءاً فطالَ صِيامُهُ وَصِيَامُها",
      "text": "حتى إذا سَلَخَا جُمَادَى ستَّةً\nجَزءاً فطالَ صِيامُهُ وَصِيَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-029",
      "number": 29,
      "first_hemistich": "رَجَعَا بأمرهما إلى ذي مِرَّةٍ",
      "second_hemistich": "حصدٍ، ونجحُ صريمة ٍ إبرامُهَا",
      "text": "رَجَعَا بأمرهما إلى ذي مِرَّةٍ\nحصدٍ، ونجحُ صريمة ٍ إبرامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-030",
      "number": 30,
      "first_hemistich": "ورمى دوابرَهَا السَّفَا وتهيَّجَتْ",
      "second_hemistich": "ريحُ المصايِفِ سَوْمُهَا وسِهامُهَا",
      "text": "ورمى دوابرَهَا السَّفَا وتهيَّجَتْ\nريحُ المصايِفِ سَوْمُهَا وسِهامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-031",
      "number": 31,
      "first_hemistich": "فتنازعا سَبِطاً يطيرُ ظلالُهُ",
      "second_hemistich": "كدخانِ مُشْعَلة ٍ يُشَبُّ ضِرَامُهَا",
      "text": "فتنازعا سَبِطاً يطيرُ ظلالُهُ\nكدخانِ مُشْعَلة ٍ يُشَبُّ ضِرَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-032",
      "number": 32,
      "first_hemistich": "مشمُولة ٍ غلِثَتْ بنابتِ عرْفَجٍ",
      "second_hemistich": "كَدُخَانِ نارٍ سَاطِعٍ أسْنَامُها",
      "text": "مشمُولة ٍ غلِثَتْ بنابتِ عرْفَجٍ\nكَدُخَانِ نارٍ سَاطِعٍ أسْنَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-033",
      "number": 33,
      "first_hemistich": "فمضى وَقَدَّمَهَا وكانتْ عادةً",
      "second_hemistich": "منه إذا هِيَ عَرَّدَتْ إقدامُها",
      "text": "فمضى وَقَدَّمَهَا وكانتْ عادةً\nمنه إذا هِيَ عَرَّدَتْ إقدامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-034",
      "number": 34,
      "first_hemistich": "فتوسَّطا عرضَ السَّريَّ وصدَّعا",
      "second_hemistich": "مسجورة ً متجاوراً قُلاَّمُهَا",
      "text": "فتوسَّطا عرضَ السَّريَّ وصدَّعا\nمسجورة ً متجاوراً قُلاَّمُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-035",
      "number": 35,
      "first_hemistich": "محفوفةً وسطَ اليراعِ يُظِلُّها",
      "second_hemistich": "مِنه مُصَرَّعُ غَابةٍ وقِيامُها",
      "text": "محفوفةً وسطَ اليراعِ يُظِلُّها\nمِنه مُصَرَّعُ غَابةٍ وقِيامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-036",
      "number": 36,
      "first_hemistich": "أفَتِلْكَ أم وحْشِيَّةٌ مسبوعَةٌ",
      "second_hemistich": "خذلتْ وهاديةُ الصِّوارِ قِوَامُها",
      "text": "أفَتِلْكَ أم وحْشِيَّةٌ مسبوعَةٌ\nخذلتْ وهاديةُ الصِّوارِ قِوَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-037",
      "number": 37,
      "first_hemistich": "خَنْساءُ ضَيَّعَتِ الفَريرَ فلمْ يَرِمْ",
      "second_hemistich": "عرضَ الشَّقائِقِ طوفُها وبغامُها",
      "text": "خَنْساءُ ضَيَّعَتِ الفَريرَ فلمْ يَرِمْ\nعرضَ الشَّقائِقِ طوفُها وبغامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-038",
      "number": 38,
      "first_hemistich": "لِمُعَفَّرٍ قَهْدٍ تَنَازَعَ شِلْوَهُ",
      "second_hemistich": "غُبْسٌ كواسِبُ لا يُمَنُّ طَعَامُها",
      "text": "لِمُعَفَّرٍ قَهْدٍ تَنَازَعَ شِلْوَهُ\nغُبْسٌ كواسِبُ لا يُمَنُّ طَعَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-039",
      "number": 39,
      "first_hemistich": "صَادَفْنَ منها غِرَّةً فَأصَبْنَهَا",
      "second_hemistich": "إنَّ المنايا لا تطيشُ سهامُهَا",
      "text": "صَادَفْنَ منها غِرَّةً فَأصَبْنَهَا\nإنَّ المنايا لا تطيشُ سهامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-040",
      "number": 40,
      "first_hemistich": "باتَتْ وَأسْبَلَ واكفٌ من ديمةٍ",
      "second_hemistich": "يروِي الخمائلَ دائماً تسجامُها",
      "text": "باتَتْ وَأسْبَلَ واكفٌ من ديمةٍ\nيروِي الخمائلَ دائماً تسجامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-041",
      "number": 41,
      "first_hemistich": "يعدُو طريقةَ متنِهَا متواتِرٌ",
      "second_hemistich": "في ليلةٍ كَفَرَ النُّجومَ غَمَامُهَا",
      "text": "يعدُو طريقةَ متنِهَا متواتِرٌ\nفي ليلةٍ كَفَرَ النُّجومَ غَمَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-042",
      "number": 42,
      "first_hemistich": "تجتافُ أصْلاً قالِصاً متنبّذاً",
      "second_hemistich": "بعجوبِ أنْقاءٍ يميلُ هُيَامُها",
      "text": "تجتافُ أصْلاً قالِصاً متنبّذاً\nبعجوبِ أنْقاءٍ يميلُ هُيَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-043",
      "number": 43,
      "first_hemistich": "وتُضيءُ في وَجْهِ الظلام مُنِيرةً",
      "second_hemistich": "كجمانَةِ البحريِّ سُلَّ نظامُها",
      "text": "وتُضيءُ في وَجْهِ الظلام مُنِيرةً\nكجمانَةِ البحريِّ سُلَّ نظامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-044",
      "number": 44,
      "first_hemistich": "حتى إذا انحسَرَ الظلامُ وَأسْفَرَتْ",
      "second_hemistich": "بكرتْ تزلُّ عن الثَّرَى أزْلامُها",
      "text": "حتى إذا انحسَرَ الظلامُ وَأسْفَرَتْ\nبكرتْ تزلُّ عن الثَّرَى أزْلامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-045",
      "number": 45,
      "first_hemistich": "عَلِهَتْ تَرّدَّدُ في نِهاءِ صَعَائِدٍ",
      "second_hemistich": "سَبْعاً تُؤاماً كاملاً أيَّامُها",
      "text": "عَلِهَتْ تَرّدَّدُ في نِهاءِ صَعَائِدٍ\nسَبْعاً تُؤاماً كاملاً أيَّامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-046",
      "number": 46,
      "first_hemistich": "حتى إذا يَئسَتْ وأسْحَقَ حَالِقٌ",
      "second_hemistich": "لم يُبلهِ إرْضاعُها وفِطَامُها",
      "text": "حتى إذا يَئسَتْ وأسْحَقَ حَالِقٌ\nلم يُبلهِ إرْضاعُها وفِطَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-047",
      "number": 47,
      "first_hemistich": "وتوجسَّتْ رزَّ الأنيسِ فَرَاعَها",
      "second_hemistich": "عن ظهرِ غَيْبٍ، والأنيسُ سَقَامُها",
      "text": "وتوجسَّتْ رزَّ الأنيسِ فَرَاعَها\nعن ظهرِ غَيْبٍ، والأنيسُ سَقَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-048",
      "number": 48,
      "first_hemistich": "فَغَدَتْ كلا الفَرجَينِ تَحْسَبُ أنَّهُ",
      "second_hemistich": "مَولى المخافة خلفُها وأمامُها",
      "text": "فَغَدَتْ كلا الفَرجَينِ تَحْسَبُ أنَّهُ\nمَولى المخافة خلفُها وأمامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-049",
      "number": 49,
      "first_hemistich": "حتى إذا يئسَ الرُّماةُ وأرْسَلُوا",
      "second_hemistich": "غضفاً دواجنَ قافلاً أعْصامُها",
      "text": "حتى إذا يئسَ الرُّماةُ وأرْسَلُوا\nغضفاً دواجنَ قافلاً أعْصامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-050",
      "number": 50,
      "first_hemistich": "فَلَحِقْنَ واعتكرتْ لها مَدْرِيَّةٌ",
      "second_hemistich": "كالسَّمهريَّةِ حَدَّهَا وتَمَامُهَا",
      "text": "فَلَحِقْنَ واعتكرتْ لها مَدْرِيَّةٌ\nكالسَّمهريَّةِ حَدَّهَا وتَمَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-051",
      "number": 51,
      "first_hemistich": "لِتذَودَهُنَّ وَأيقنتْ إن لم تَذُدْ",
      "second_hemistich": "أن قد أحمَّ مع الحتوفِ حمامُها",
      "text": "لِتذَودَهُنَّ وَأيقنتْ إن لم تَذُدْ\nأن قد أحمَّ مع الحتوفِ حمامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-052",
      "number": 52,
      "first_hemistich": "فتقصدَتْ منها كَسابِ فضُرِّجتْ",
      "second_hemistich": "بدمٍ وغودرَ في المَكَرِّ سُخَامُها",
      "text": "فتقصدَتْ منها كَسابِ فضُرِّجتْ\nبدمٍ وغودرَ في المَكَرِّ سُخَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-053",
      "number": 53,
      "first_hemistich": "فبتلْكَ إذْ رقَصَ اللوامعُ بالضُّحى",
      "second_hemistich": "واجتابَ أرديةَ السَّرَابِ إكامُها",
      "text": "فبتلْكَ إذْ رقَصَ اللوامعُ بالضُّحى\nواجتابَ أرديةَ السَّرَابِ إكامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-054",
      "number": 54,
      "first_hemistich": "أقضي اللُّبانةَ لا أفرِّطُ ريبةً",
      "second_hemistich": "أو أن يلومَ بحاجةٍ لُوَّامُهَا",
      "text": "أقضي اللُّبانةَ لا أفرِّطُ ريبةً\nأو أن يلومَ بحاجةٍ لُوَّامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-055",
      "number": 55,
      "first_hemistich": "أوَلم تكنْ تدري نَوَارُ بأنَّني",
      "second_hemistich": "وَصَّالُ عَقْدِ حَبَائِلٍ جَذَّامُها",
      "text": "أوَلم تكنْ تدري نَوَارُ بأنَّني\nوَصَّالُ عَقْدِ حَبَائِلٍ جَذَّامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-056",
      "number": 56,
      "first_hemistich": "تَرَّاكُ أمكنةٍ إذا لم أرْضَهَا",
      "second_hemistich": "أوْ يعتلقْ بعضَ النفوسِ حِمامُها",
      "text": "تَرَّاكُ أمكنةٍ إذا لم أرْضَهَا\nأوْ يعتلقْ بعضَ النفوسِ حِمامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-057",
      "number": 57,
      "first_hemistich": "بل أنتِ لا تدرين كم مِنْ ليلةٍ",
      "second_hemistich": "طَلْقٍ لذيذٍ لَهْوُها ونِدَامُها",
      "text": "بل أنتِ لا تدرين كم مِنْ ليلةٍ\nطَلْقٍ لذيذٍ لَهْوُها ونِدَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-058",
      "number": 58,
      "first_hemistich": "قَد بِتُّ سامِرَها، وغَاية تاجرٍ",
      "second_hemistich": "وافيتُ إذ رُفِعَتْ وَعَزَّ مُدَامُها",
      "text": "قَد بِتُّ سامِرَها، وغَاية تاجرٍ\nوافيتُ إذ رُفِعَتْ وَعَزَّ مُدَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-059",
      "number": 59,
      "first_hemistich": "أُغْلي السِّباءَ بكلِّ أدْكَنَ عاتقٍ",
      "second_hemistich": "أو جَوْنَةٍ قُدِحَتْ وفُضَّ خِتامُها",
      "text": "أُغْلي السِّباءَ بكلِّ أدْكَنَ عاتقٍ\nأو جَوْنَةٍ قُدِحَتْ وفُضَّ خِتامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-060",
      "number": 60,
      "first_hemistich": "بصَبوحِ صافيةٍ وجذبِ كرينةٍ",
      "second_hemistich": "بموَتَّرٍ تأتالُهُ إبهامُهَا",
      "text": "بصَبوحِ صافيةٍ وجذبِ كرينةٍ\nبموَتَّرٍ تأتالُهُ إبهامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-061",
      "number": 61,
      "first_hemistich": "بادرتُ حاجتَها الدّجاجَ بسحرَةٍ",
      "second_hemistich": "لأعَلَّ منها حينَ هبّ نيامُها",
      "text": "بادرتُ حاجتَها الدّجاجَ بسحرَةٍ\nلأعَلَّ منها حينَ هبّ نيامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-062",
      "number": 62,
      "first_hemistich": "وغداةِ ريحٍ قَدْ وزعتُ وَقَرَّةٍ",
      "second_hemistich": "إذ أصْبَحَتْ بيدِ الشَّمالِ زمامُها",
      "text": "وغداةِ ريحٍ قَدْ وزعتُ وَقَرَّةٍ\nإذ أصْبَحَتْ بيدِ الشَّمالِ زمامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-063",
      "number": 63,
      "first_hemistich": "ولقَد حميْتُ الحيَّ تحملُ شِكَّتي",
      "second_hemistich": "فرطٌ، وشاحي إذْ غدوتُ لجامُها",
      "text": "ولقَد حميْتُ الحيَّ تحملُ شِكَّتي\nفرطٌ، وشاحي إذْ غدوتُ لجامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-064",
      "number": 64,
      "first_hemistich": "فعَلوتُ مرتقباً عَلى ذي هَبْوَةٍ",
      "second_hemistich": "حَرِجٍ إلى أعلامِهِنَّ قَتَامُها",
      "text": "فعَلوتُ مرتقباً عَلى ذي هَبْوَةٍ\nحَرِجٍ إلى أعلامِهِنَّ قَتَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-065",
      "number": 65,
      "first_hemistich": "حتى إذا ألْقَتْ يداً في كافرٍ",
      "second_hemistich": "وَأجَنَّ عَوْرَاتِ الثُّغُورِ ظَلامُها",
      "text": "حتى إذا ألْقَتْ يداً في كافرٍ\nوَأجَنَّ عَوْرَاتِ الثُّغُورِ ظَلامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-066",
      "number": 66,
      "first_hemistich": "أسْهلْتُ وانتصَبتْ كجذع منيفَةٍ",
      "second_hemistich": "جَرْدَاءَ يَحْصَرُ دونها جُرَّامُها",
      "text": "أسْهلْتُ وانتصَبتْ كجذع منيفَةٍ\nجَرْدَاءَ يَحْصَرُ دونها جُرَّامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-067",
      "number": 67,
      "first_hemistich": "رَفَّعْتُهَا طَرَدَ النَّعامِ وَشَلَّهُ",
      "second_hemistich": "حتى إذا سَخِنَتْ وَخَفَّ عظامُها",
      "text": "رَفَّعْتُهَا طَرَدَ النَّعامِ وَشَلَّهُ\nحتى إذا سَخِنَتْ وَخَفَّ عظامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-068",
      "number": 68,
      "first_hemistich": "قَلِقَتْ رِحَالَتُهَا وَأسْبَلَ نَحْرُهَا",
      "second_hemistich": "وابتلَّ من زَبَدِ الحمِيمِ حِزَامُهَا",
      "text": "قَلِقَتْ رِحَالَتُهَا وَأسْبَلَ نَحْرُهَا\nوابتلَّ من زَبَدِ الحمِيمِ حِزَامُهَا",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-069",
      "number": 69,
      "first_hemistich": "تَرْقَى وَتَطَعْنُ في العِنَانِ وتَنْتَحي",
      "second_hemistich": "وِرْدَ الحمَامة إذ أجَدَّ حَمَامُها",
      "text": "تَرْقَى وَتَطَعْنُ في العِنَانِ وتَنْتَحي\nوِرْدَ الحمَامة إذ أجَدَّ حَمَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-070",
      "number": 70,
      "first_hemistich": "وكثيرةٍ غُرَباؤهَا مَجْهُولَةٍ",
      "second_hemistich": "ترجَى نوافِلُها ويخْشَى ذامُها",
      "text": "وكثيرةٍ غُرَباؤهَا مَجْهُولَةٍ\nترجَى نوافِلُها ويخْشَى ذامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-071",
      "number": 71,
      "first_hemistich": "غُلْبٌ تَشَذَّرُ بالذُّحُولِ كأنَّهَا",
      "second_hemistich": "جنُّ البديِّ رواسياً أقدامُها",
      "text": "غُلْبٌ تَشَذَّرُ بالذُّحُولِ كأنَّهَا\nجنُّ البديِّ رواسياً أقدامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-072",
      "number": 72,
      "first_hemistich": "أنكرتُ باطلَها وَبُؤْتُ بحقِّها",
      "second_hemistich": "عندي، ولم يَفْخَرْ عليَّ كرامُها",
      "text": "أنكرتُ باطلَها وَبُؤْتُ بحقِّها\nعندي، ولم يَفْخَرْ عليَّ كرامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-073",
      "number": 73,
      "first_hemistich": "وَجزَورِ أيْسَارٍ دَعَوْتُ لحتفِها",
      "second_hemistich": "بِمَغَالِقٍ مُتَشَابهٍ أجسامُها",
      "text": "وَجزَورِ أيْسَارٍ دَعَوْتُ لحتفِها\nبِمَغَالِقٍ مُتَشَابهٍ أجسامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-074",
      "number": 74,
      "first_hemistich": "أدعُو بهنَّ لعاقِرِ أوْ مطفِلٍ",
      "second_hemistich": "بذلَتْ لجيرانِ الجميعِ لحامُها",
      "text": "أدعُو بهنَّ لعاقِرِ أوْ مطفِلٍ\nبذلَتْ لجيرانِ الجميعِ لحامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-075",
      "number": 75,
      "first_hemistich": "فالضيفُ والجارُ الجنيبُ كأنّما",
      "second_hemistich": "هبَطَا تبالَةَ مخصِباً أهْضَامُها",
      "text": "فالضيفُ والجارُ الجنيبُ كأنّما\nهبَطَا تبالَةَ مخصِباً أهْضَامُها",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-labid-076",
      "number": 76,
      "first_hemistich": "تأوِي إلى الأطْنابِ كلُّ رذيَّةٍ",
