      "title": "آذنتنا ببينها أسماء",
      "number": 1
    }
  ],
  "verses": [
    {
      "id": "muallaqa-harith-001",
      "number": 1,
      "first_hemistich": "آذَنَتنَا بِبَينها أَسمَاءُ",
      "second_hemistich": "رُبَّ ثَاوٍ يَمَلُّ مِنهُ الثَّواءُ",
      "text": "آذَنَتنَا بِبَينها أَسمَاءُ\nرُبَّ ثَاوٍ يَمَلُّ مِنهُ الثَّواءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-002",
      "number": 2,
      "first_hemistich": "بَعدَ عَهدٍ لَنا بِبُرقَةِ شَمَّاءَ",
      "second_hemistich": "فَأَدنَى دِيَارِها الخَلْصَاءُ",
      "text": "بَعدَ عَهدٍ لَنا بِبُرقَةِ شَمَّاءَ\nفَأَدنَى دِيَارِها الخَلْصَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-003",
      "number": 3,
      "first_hemistich": "فَالمحيّاةُ فَالصّفاجُ فَأعْنَاقُ",
      "second_hemistich": "فِتَاقٍ فَعاذِبٌ فَالوَفاءُ",
      "text": "فَالمحيّاةُ فَالصّفاجُ فَأعْنَاقُ\nفِتَاقٍ فَعاذِبٌ فَالوَفاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-004",
      "number": 4,
      "first_hemistich": "فَريَاضُ القَطَا فَأوْدِيَةُ الشُ",
      "second_hemistich": "ربُبِ فَالشُعبَتَانِ فَالأَبْلاءُ",
      "text": "فَريَاضُ القَطَا فَأوْدِيَةُ الشُ\nربُبِ فَالشُعبَتَانِ فَالأَبْلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-005",
      "number": 5,
      "first_hemistich": "لا أَرَى مَن عَهِدتُ فِيهَا فَأبْكِي",
      "second_hemistich": "اليَومَ دَلهاً وَمَا يُحَيِّرُ البُكَاءُ",
      "text": "لا أَرَى مَن عَهِدتُ فِيهَا فَأبْكِي\nاليَومَ دَلهاً وَمَا يُحَيِّرُ البُكَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-006",
      "number": 6,
      "first_hemistich": "وبِعَينَيكَ أَوقَدَت هِندٌ النَّارَ",
      "second_hemistich": "أَخِيراً تُلوِي بِهَا العَلْيَاءُ",
      "text": "وبِعَينَيكَ أَوقَدَت هِندٌ النَّارَ\nأَخِيراً تُلوِي بِهَا العَلْيَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-007",
      "number": 7,
      "first_hemistich": "فَتَنَوَّرتُ نَارَهَا مِن بَعِيدٍ",
      "second_hemistich": "بِخَزَازى هَيهَاتَ مِنكَ الصَّلاءُ",
      "text": "فَتَنَوَّرتُ نَارَهَا مِن بَعِيدٍ\nبِخَزَازى هَيهَاتَ مِنكَ الصَّلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-008",
      "number": 8,
      "first_hemistich": "أَوقَدتها بَينَ العَقِيقِ فَشَخصَينِ",
      "second_hemistich": "بِعُودٍ كَمَا يَلُوحُ الضِياءُ",
      "text": "أَوقَدتها بَينَ العَقِيقِ فَشَخصَينِ\nبِعُودٍ كَمَا يَلُوحُ الضِياءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-009",
      "number": 9,
      "first_hemistich": "غَيرَ أَنِّي قَد أَستَعِينُ عَلَى الهَمِّ",
      "second_hemistich": "إِذَا خَفَّ بِالثَّوِيِّ النَجَاءُ",
      "text": "غَيرَ أَنِّي قَد أَستَعِينُ عَلَى الهَمِّ\nإِذَا خَفَّ بِالثَّوِيِّ النَجَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-010",
      "number": 10,
      "first_hemistich": "بِزَفُوفٍ كَأَنَّها هِقَلةٌ",
      "second_hemistich": "أُمُّ رِئَالٍ دَوِيَّةٌ سَقْفَاءُ",
      "text": "بِزَفُوفٍ كَأَنَّها هِقَلةٌ\nأُمُّ رِئَالٍ دَوِيَّةٌ سَقْفَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-011",
      "number": 11,
      "first_hemistich": "آنَسَت نَبأَةً وأَفْزَعَها القَنَّاصُ",
      "second_hemistich": "آعَصراً وَقَد دَنَا الإِمْسَاءُ",
      "text": "آنَسَت نَبأَةً وأَفْزَعَها القَنَّاصُ\nآعَصراً وَقَد دَنَا الإِمْسَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-012",
      "number": 12,
      "first_hemistich": "فَتَرَى خَلْفَها مِنَ الرَّجعِ وَال",
      "second_hemistich": "وَقْعِ مَنِيناً كَأَنَّهُ إِهْبَاءُ",
      "text": "فَتَرَى خَلْفَها مِنَ الرَّجعِ وَال\nوَقْعِ مَنِيناً كَأَنَّهُ إِهْبَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-013",
      "number": 13,
      "first_hemistich": "وَطِرَاقاً مِن خَلفِهِنَّ طِرَاقٌ",
      "second_hemistich": "سَاقِطَاتٌ أَلوَتْ بِهَا الصَحرَاءُ",
      "text": "وَطِرَاقاً مِن خَلفِهِنَّ طِرَاقٌ\nسَاقِطَاتٌ أَلوَتْ بِهَا الصَحرَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-014",
      "number": 14,
      "first_hemistich": "أَتَلَهَّى بِهَا الهَوَاجِرَ إِذ كُلُّ",
      "second_hemistich": "ابنَ هَمٍّ بَلِيَّةٌ عَميَاءُ",
      "text": "أَتَلَهَّى بِهَا الهَوَاجِرَ إِذ كُلُّ\nابنَ هَمٍّ بَلِيَّةٌ عَميَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-015",
      "number": 15,
      "first_hemistich": "وأَتَانَا مِنَ الحَوَادِثِ والأَنبَاءِ",
      "second_hemistich": "خَطبٌ نُعنَى بِهِ وَنُسَاءُ",
      "text": "وأَتَانَا مِنَ الحَوَادِثِ والأَنبَاءِ\nخَطبٌ نُعنَى بِهِ وَنُسَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-016",
      "number": 16,
      "first_hemistich": "إِنَّ إِخوَانَنا الأَرَاقِمَ يَغلُونَ",
      "second_hemistich": "عَلَينَا فِي قَيلِهِم إِخْفَاءُ",
      "text": "إِنَّ إِخوَانَنا الأَرَاقِمَ يَغلُونَ\nعَلَينَا فِي قَيلِهِم إِخْفَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-017",
      "number": 17,
      "first_hemistich": "يَخلِطُونَ البَرِيءَ مِنَّا بِذِي ال",
      "second_hemistich": "ذَنبِ وَلا يَنفَعُ الخَلِيَّ الخِلاءُ",
      "text": "يَخلِطُونَ البَرِيءَ مِنَّا بِذِي ال\nذَنبِ وَلا يَنفَعُ الخَلِيَّ الخِلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-018",
      "number": 18,
      "first_hemistich": "زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العِيرَ",
      "second_hemistich": "مُوَالٍ لَنَا وَأَنَا الوَلاءُ",
      "text": "زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العِيرَ\nمُوَالٍ لَنَا وَأَنَا الوَلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-019",
      "number": 19,
      "first_hemistich": "أَجمَعُوا أَمرَهُم عِشاءً فَلَمَّا",
      "second_hemistich": "أَصبَحُوا أَصبَحَت لَهُم ضَوْضَاءُ",
      "text": "أَجمَعُوا أَمرَهُم عِشاءً فَلَمَّا\nأَصبَحُوا أَصبَحَت لَهُم ضَوْضَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-020",
      "number": 20,
      "first_hemistich": "مِن مُنَادٍ وَمِن مُجِيبٍ وَمِن",
      "second_hemistich": "تَصهَالِ خَيلٍ خِلالَ ذَاكَ رُغَاءُ",
      "text": "مِن مُنَادٍ وَمِن مُجِيبٍ وَمِن\nتَصهَالِ خَيلٍ خِلالَ ذَاكَ رُغَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-021",
      "number": 21,
      "first_hemistich": "أَيُّهَا النَاطِقُ المُرَقِّشُ عَنَّا",
      "second_hemistich": "عِندَ عَمروٍ وَهَل لِذَاكَ بَقَاءُ",
      "text": "أَيُّهَا النَاطِقُ المُرَقِّشُ عَنَّا\nعِندَ عَمروٍ وَهَل لِذَاكَ بَقَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-022",
      "number": 22,
      "first_hemistich": "لا تَخَلنَا عَلَى غِرَاتِك إِنّا",
      "second_hemistich": "قَبلُ مَا قَد وَشَى بِنَا الأَعْدَاءُ",
      "text": "لا تَخَلنَا عَلَى غِرَاتِك إِنّا\nقَبلُ مَا قَد وَشَى بِنَا الأَعْدَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-023",
      "number": 23,
      "first_hemistich": "فَبَقَينَا عَلَى الشَناءَةِ",
      "second_hemistich": "تَنمِينَا حُصُونٌ وَعِزَّةٌ قَعسَاءُ",
      "text": "فَبَقَينَا عَلَى الشَناءَةِ\nتَنمِينَا حُصُونٌ وَعِزَّةٌ قَعسَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-024",
      "number": 24,
      "first_hemistich": "قَبلَ مَا اليَومِ بَيَّضَت بِعُيونِ",
      "second_hemistich": "النَّاسِ فِيهَا تَغَيُّظٌ وَإِبَاءُ",
      "text": "قَبلَ مَا اليَومِ بَيَّضَت بِعُيونِ\nالنَّاسِ فِيهَا تَغَيُّظٌ وَإِبَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-025",
      "number": 25,
      "first_hemistich": "فَكَأَنَّ المَنونَ تَردِي بِنَا أَرعَنَ",
      "second_hemistich": "جَوناً يَنجَابُ عَنهُ العَماءُ",
      "text": "فَكَأَنَّ المَنونَ تَردِي بِنَا أَرعَنَ\nجَوناً يَنجَابُ عَنهُ العَماءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-026",
      "number": 26,
      "first_hemistich": "مُكفَهِراً عَلَى الحَوَادِثِ لا تَرتُوهُ",
      "second_hemistich": "للدَهرِ مُؤَيِّدٌ صَمَّاءُ",
      "text": "مُكفَهِراً عَلَى الحَوَادِثِ لا تَرتُوهُ\nللدَهرِ مُؤَيِّدٌ صَمَّاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-027",
      "number": 27,
      "first_hemistich": "رمِيٌّ بِمِثلِهِ جَالَتِ الخَيلُ",
      "second_hemistich": "فَآبَت لِخَصمِهَا الإِجلاَءُ",
      "text": "رمِيٌّ بِمِثلِهِ جَالَتِ الخَيلُ\nفَآبَت لِخَصمِهَا الإِجلاَءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-028",
      "number": 28,
      "first_hemistich": "مَلِكٌ مُقسِطٌ وأَفضَلُ مَن يَمشِي",
      "second_hemistich": "وَمِن دُونَ مَا لَدَيهِ الثَّنَاءُ",
      "text": "مَلِكٌ مُقسِطٌ وأَفضَلُ مَن يَمشِي\nوَمِن دُونَ مَا لَدَيهِ الثَّنَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-029",
      "number": 29,
      "first_hemistich": "أَيَّمَا خُطَّةٍ أَرَدتُم فَأَدوهَا",
      "second_hemistich": "إِلَينَا تُشفَى بِهَا الأَملاءُ",
      "text": "أَيَّمَا خُطَّةٍ أَرَدتُم فَأَدوهَا\nإِلَينَا تُشفَى بِهَا الأَملاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-030",
      "number": 30,
      "first_hemistich": "إِن نَبَشتُم مَا بَينَ مِلحَةَ فَال",
      "second_hemistich": "صَاقِبِ فِيهِ الأَموَاتُ وَالأَحَيَاءُ",
      "text": "إِن نَبَشتُم مَا بَينَ مِلحَةَ فَال\nصَاقِبِ فِيهِ الأَموَاتُ وَالأَحَيَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-031",
      "number": 31,
      "first_hemistich": "أَو نَقَشتُم فَالنَّقشُ يَجشَمُهُ",
      "second_hemistich": "النَّاسُ وَفِيهِ الإِسقَامُ وَالإِبرَاءُ",
      "text": "أَو نَقَشتُم فَالنَّقشُ يَجشَمُهُ\nالنَّاسُ وَفِيهِ الإِسقَامُ وَالإِبرَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-032",
      "number": 32,
      "first_hemistich": "أَو سَكَتُّم عَنَّا فَكُنَّا كَمَن أَغمَضَ",
      "second_hemistich": "عَيناً فِي جَفنِهَا الأَقذَاءُ",
      "text": "أَو سَكَتُّم عَنَّا فَكُنَّا كَمَن أَغمَضَ\nعَيناً فِي جَفنِهَا الأَقذَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-033",
      "number": 33,
      "first_hemistich": "أَو مَنَعتُم مَا تُسأَلُونَ فَمَن حُدِّ",
      "second_hemistich": "ثتُمُوهُ لَهُ عَلَينَا العَتلاءُ",
      "text": "أَو مَنَعتُم مَا تُسأَلُونَ فَمَن حُدِّ\nثتُمُوهُ لَهُ عَلَينَا العَتلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-034",
      "number": 34,
      "first_hemistich": "هَل عَلِمتُم أَيَّامَ يُنتَهَبُ النَّاسُ",
      "second_hemistich": "غِوَاراً لِكُلِّ حَيٍّ عُواءُ",
      "text": "هَل عَلِمتُم أَيَّامَ يُنتَهَبُ النَّاسُ\nغِوَاراً لِكُلِّ حَيٍّ عُواءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-035",
      "number": 35,
      "first_hemistich": "إِذ رَفَعنَا الجِمَالَ مِن سَعَفِ ال",
      "second_hemistich": "بَحرَينِ سَيراً حَتَّى نَهَاهَا الحِسَاءُ",
      "text": "إِذ رَفَعنَا الجِمَالَ مِن سَعَفِ ال\nبَحرَينِ سَيراً حَتَّى نَهَاهَا الحِسَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-036",
      "number": 36,
      "first_hemistich": "ثُمَّ مِلنَا عَلَى تَمِيمٍ فَأَحرَمنَا",
      "second_hemistich": "وَفِينَا بَنَاتُ قَومٍ إِمَاءُ",
      "text": "ثُمَّ مِلنَا عَلَى تَمِيمٍ فَأَحرَمنَا\nوَفِينَا بَنَاتُ قَومٍ إِمَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-037",
      "number": 37,
      "first_hemistich": "لا يُقِيمُ العَزيزُ بِالبَلَدِ السَهلِ",
      "second_hemistich": "وَلا يَنفَعُ الذَّلِيلَ النِجَاءُ",
      "text": "لا يُقِيمُ العَزيزُ بِالبَلَدِ السَهلِ\nوَلا يَنفَعُ الذَّلِيلَ النِجَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-038",
      "number": 38,
      "first_hemistich": "لَيسَ يُنجِي الذِي يُوَائِل مِنَّا",
      "second_hemistich": "رَأْسُ طَوْدٍ وَحَرَّةٌ رَجلاءُ",
      "text": "لَيسَ يُنجِي الذِي يُوَائِل مِنَّا\nرَأْسُ طَوْدٍ وَحَرَّةٌ رَجلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-039",
      "number": 39,
      "first_hemistich": "مَلِكٌ أَضلَعَ البَرِيَّةِ لا يُوجَدُ",
      "second_hemistich": "فِيهَا لِمَا لَدَيهِ كِفَاءُ",
      "text": "مَلِكٌ أَضلَعَ البَرِيَّةِ لا يُوجَدُ\nفِيهَا لِمَا لَدَيهِ كِفَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-040",
      "number": 40,
      "first_hemistich": "كَتَكَالِيفِ قَومِنَا إِذَا غَزَا المَنذِرُ",
      "second_hemistich": "هَلِ نَحنُ لابنِ هِندٍ رِعَاءُ",
      "text": "كَتَكَالِيفِ قَومِنَا إِذَا غَزَا المَنذِرُ\nهَلِ نَحنُ لابنِ هِندٍ رِعَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-041",
      "number": 41,
      "first_hemistich": "مَا أَصَابُوا مِن تَغلَبِي فَمَطَلولٌ",
      "second_hemistich": "عَلَيهِ إِذَا أُصِيبَ العَفَاءُ",
      "text": "مَا أَصَابُوا مِن تَغلَبِي فَمَطَلولٌ\nعَلَيهِ إِذَا أُصِيبَ العَفَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-042",
      "number": 42,
      "first_hemistich": "إِذَ أَحَلَّ العَلاةَ قُبَّةَ مَيسُونَ",
      "second_hemistich": "فَأَدنَى دِيَارِهَا العَوصَاءُ",
      "text": "إِذَ أَحَلَّ العَلاةَ قُبَّةَ مَيسُونَ\nفَأَدنَى دِيَارِهَا العَوصَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-043",
      "number": 43,
      "first_hemistich": "فَتَأَوَّت لَهُ قَرَاضِبَةٌ مِن",
      "second_hemistich": "كُلِّ حَيٍّ كَأَنَّهُم أَلقَاءُ",
      "text": "فَتَأَوَّت لَهُ قَرَاضِبَةٌ مِن\nكُلِّ حَيٍّ كَأَنَّهُم أَلقَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-044",
      "number": 44,
      "first_hemistich": "فَهَداهُم بِالأَسوَدَينِ وأَمرُ اللهِ",
      "second_hemistich": "بَالِغٌ تَشقَى بِهِ الأَشقِيَاءُ",
      "text": "فَهَداهُم بِالأَسوَدَينِ وأَمرُ اللهِ\nبَالِغٌ تَشقَى بِهِ الأَشقِيَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-045",
      "number": 45,
      "first_hemistich": "إِذ تَمَنَّونَهُم غُرُوراً فَسَاقَتهُم",
      "second_hemistich": "إِلَيكُم أُمنِيَّةٌ أَشرَاءُ",
      "text": "إِذ تَمَنَّونَهُم غُرُوراً فَسَاقَتهُم\nإِلَيكُم أُمنِيَّةٌ أَشرَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-046",
      "number": 46,
      "first_hemistich": "لَم يَغُرّوكُم غُرُوراً وَلَكن",
      "second_hemistich": "رَفَعَ الآلُ شَخصَهُم وَالضَحَاءُ",
      "text": "لَم يَغُرّوكُم غُرُوراً وَلَكن\nرَفَعَ الآلُ شَخصَهُم وَالضَحَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-047",
      "number": 47,
      "first_hemistich": "أَيُّها النَاطِقُ المُبَلِّغُ عَنَّا",
      "second_hemistich": "عِندَ عَمروٍ وَهَل لِذَكَ انتِهَاءُ",
      "text": "أَيُّها النَاطِقُ المُبَلِّغُ عَنَّا\nعِندَ عَمروٍ وَهَل لِذَكَ انتِهَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-048",
      "number": 48,
      "first_hemistich": "مَن لَنَا عِندَهُ مِنَ الخَيرِ",
      "second_hemistich": "آيَاتٌ ثَلاثٌ فِي كُلِّهِنَّ القَضَاءُ",
      "text": "مَن لَنَا عِندَهُ مِنَ الخَيرِ\nآيَاتٌ ثَلاثٌ فِي كُلِّهِنَّ القَضَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-049",
      "number": 49,
      "first_hemistich": "آيَةٌ شَارِقُ الشّقِيقَةِ إِذَا جَاءَت",
      "second_hemistich": "مَعَدٌّ لِكُلِّ حَيٍّ لِوَاءُ",
      "text": "آيَةٌ شَارِقُ الشّقِيقَةِ إِذَا جَاءَت\nمَعَدٌّ لِكُلِّ حَيٍّ لِوَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-050",
      "number": 50,
      "first_hemistich": "حَولَ قَيسٍ مُستَلئِمِينَ بِكَبشٍ",
      "second_hemistich": "قَرَظِيٍ كَأَنَّهُ عَبلاءُ",
      "text": "حَولَ قَيسٍ مُستَلئِمِينَ بِكَبشٍ\nقَرَظِيٍ كَأَنَّهُ عَبلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-051",
      "number": 51,
      "first_hemistich": "وَصَتِيتٍ مِنَ العَواتِكِ لا تَنهَاهُ",
      "second_hemistich": "إِلاَّ مُبيَضَّةٌ رَعلاءُ",
      "text": "وَصَتِيتٍ مِنَ العَواتِكِ لا تَنهَاهُ\nإِلاَّ مُبيَضَّةٌ رَعلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-052",
      "number": 52,
      "first_hemistich": "فَرَدَدنَاهُمُ بِطَعنٍ كَمَا يَخرُجُ",
      "second_hemistich": "مِن خُربَةِ المَزَادِ المَاءُ",
      "text": "فَرَدَدنَاهُمُ بِطَعنٍ كَمَا يَخرُجُ\nمِن خُربَةِ المَزَادِ المَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-053",
      "number": 53,
      "first_hemistich": "وَحَمَلنَاهُمُ عَلَى حَزمِ ثَهلانِ",
      "second_hemistich": "شِلالاً وَدُمِّيَ الأَنسَاءُ",
      "text": "وَحَمَلنَاهُمُ عَلَى حَزمِ ثَهلانِ\nشِلالاً وَدُمِّيَ الأَنسَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-054",
      "number": 54,
      "first_hemistich": "وَجَبَهنَاهُمُ بِطَعنٍ كَمَا تُنهَزُ",
      "second_hemistich": "فِي جَمَّةِ الطَوِيِّ الدِلاءُ",
      "text": "وَجَبَهنَاهُمُ بِطَعنٍ كَمَا تُنهَزُ\nفِي جَمَّةِ الطَوِيِّ الدِلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-055",
      "number": 55,
      "first_hemistich": "وَفَعَلنَا بِهِم كَمَا عَلِمَ اللهُ",
      "second_hemistich": "ومَا أَن للحَائِنِينَ دِمَاءُ",
      "text": "وَفَعَلنَا بِهِم كَمَا عَلِمَ اللهُ\nومَا أَن للحَائِنِينَ دِمَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-056",
      "number": 56,
      "first_hemistich": "ثُمَّ حُجراً أَعنَي ابنَ أُمِّ قَطَامٍ",
      "second_hemistich": "وَلَهُ فَارِسِيَّةٌ خَضرَاءُ",
      "text": "ثُمَّ حُجراً أَعنَي ابنَ أُمِّ قَطَامٍ\nوَلَهُ فَارِسِيَّةٌ خَضرَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-057",
      "number": 57,
      "first_hemistich": "أَسَدٌ فِي اللِقَاءِ وَردٌ هَمُوسٌ",
      "second_hemistich": "وَرَبِيعٌ إِن شَمَّرَت غَبرَاءُ",
      "text": "أَسَدٌ فِي اللِقَاءِ وَردٌ هَمُوسٌ\nوَرَبِيعٌ إِن شَمَّرَت غَبرَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-058",
      "number": 58,
      "first_hemistich": "وَفَكَكنَا غُلَّ امرِيِء القَيسِ عَنهُ",
      "second_hemistich": "بَعدَ مَا طَالَ حَبسُهُ والعَنَاءُ",
      "text": "وَفَكَكنَا غُلَّ امرِيِء القَيسِ عَنهُ\nبَعدَ مَا طَالَ حَبسُهُ والعَنَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-059",
      "number": 59,
      "first_hemistich": "وَمَعَ الجَونِ جَونِ آلِ بَنِي الأَوسِ",
      "second_hemistich": "عَتُودٌ كَأَنَّها دَفوَاءُ",
      "text": "وَمَعَ الجَونِ جَونِ آلِ بَنِي الأَوسِ\nعَتُودٌ كَأَنَّها دَفوَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-060",
      "number": 60,
      "first_hemistich": "مَا جَزِعنَا تَحتَ العَجَاجَةِ إِذ وَلُّوا",
      "second_hemistich": "شِلالاً وَإِذ تَلَظَّى الصِلاءُ",
      "text": "مَا جَزِعنَا تَحتَ العَجَاجَةِ إِذ وَلُّوا\nشِلالاً وَإِذ تَلَظَّى الصِلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-061",
      "number": 61,
      "first_hemistich": "وَأَقَدنَاهُ رَبَّ غَسَّانَ بِالمُنذِرِ",
      "second_hemistich": "كَرهاً إِذ لا تُكَالُ الدِمَاءُ",
      "text": "وَأَقَدنَاهُ رَبَّ غَسَّانَ بِالمُنذِرِ\nكَرهاً إِذ لا تُكَالُ الدِمَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-062",
      "number": 62,
      "first_hemistich": "وأَتَينَاهُمُ بِتِسعَةِ أَملاكٍ",
      "second_hemistich": "كِرَامٍ أَسلابُهُم أَغلاءُ",
      "text": "وأَتَينَاهُمُ بِتِسعَةِ أَملاكٍ\nكِرَامٍ أَسلابُهُم أَغلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-063",
      "number": 63,
      "first_hemistich": "وَوَلَدنَا عَمرو بنِ أُمِّ أنَاسٍ",
      "second_hemistich": "مِن قَرِيبٍ لَمَّا أَتَانَا الحِبَاءُ",
      "text": "وَوَلَدنَا عَمرو بنِ أُمِّ أنَاسٍ\nمِن قَرِيبٍ لَمَّا أَتَانَا الحِبَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-064",
      "number": 64,
      "first_hemistich": "مِثلُهَا تُخرِجُ النَصِيحةَ للقَومِ",
      "second_hemistich": "فَلاةٌ مِن دُونِهَا أَفلاءُ",
      "text": "مِثلُهَا تُخرِجُ النَصِيحةَ للقَومِ\nفَلاةٌ مِن دُونِهَا أَفلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-065",
      "number": 65,
      "first_hemistich": "فَاتْرُكُوا الطَيخَ والتَعَاشِي وَإِمّا",
      "second_hemistich": "تَتَعَاشَوا فَفِي التَعَاشِي الدَّاءُ",
      "text": "فَاتْرُكُوا الطَيخَ والتَعَاشِي وَإِمّا\nتَتَعَاشَوا فَفِي التَعَاشِي الدَّاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-066",
      "number": 66,
      "first_hemistich": "وَاذكُرُوا حِلفَ ذِي المَجَازِ وَمَا",
      "second_hemistich": "قُدِّمَ فِيهِ العُهُودُ وَالكُفَلاءُ",
      "text": "وَاذكُرُوا حِلفَ ذِي المَجَازِ وَمَا\nقُدِّمَ فِيهِ العُهُودُ وَالكُفَلاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-067",
      "number": 67,
      "first_hemistich": "حَذَرَ الجَورِ وَالتَعدِّي وَهَل يَنقُضُ",
      "second_hemistich": "مَا فِي المَهَارِقِ الأَهوَاءُ",
      "text": "حَذَرَ الجَورِ وَالتَعدِّي وَهَل يَنقُضُ\nمَا فِي المَهَارِقِ الأَهوَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-068",
      "number": 68,
      "first_hemistich": "وَاعلَمُوا أَنَّنَا وَإِيَّاكُم فِي مَا",
      "second_hemistich": "إِشتَرَطنَا يَومَ إِختَلَفنَا سَوَاءُ",
      "text": "وَاعلَمُوا أَنَّنَا وَإِيَّاكُم فِي مَا\nإِشتَرَطنَا يَومَ إِختَلَفنَا سَوَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-069",
      "number": 69,
      "first_hemistich": "عَنَناً بَاطِلاً وَظُلماً كَمَا تُعتَرُ",
      "second_hemistich": "عَن حَجرَةِ الرَبِيضِ الظَّبَاءُ",
      "text": "عَنَناً بَاطِلاً وَظُلماً كَمَا تُعتَرُ\nعَن حَجرَةِ الرَبِيضِ الظَّبَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-070",
      "number": 70,
      "first_hemistich": "أَعَلَينَا جُنَاحُ كِندَةَ أَن يَغنَمَ",
      "second_hemistich": "غَازِيهُمُ وَمِنَّا الجَزَاءُ",
      "text": "أَعَلَينَا جُنَاحُ كِندَةَ أَن يَغنَمَ\nغَازِيهُمُ وَمِنَّا الجَزَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-071",
      "number": 71,
      "first_hemistich": "أَم عَلَينَا جَرَّى إيَادٍ كَمَا نِيطَ",
      "second_hemistich": "بِجَوزِ المُحمَّلِ الأَعبَاءُ",
      "text": "أَم عَلَينَا جَرَّى إيَادٍ كَمَا نِيطَ\nبِجَوزِ المُحمَّلِ الأَعبَاءُ",
      "chapter_id": "qasida"
    },
    {
      "id": "muallaqa-harith-072",
      "number": 72,
      "first_hemistich": "لَيسَ منَّا المُضَرَّبُونَ وَلا قَيسٌ",
      "second_hemistich": "وَلا جَندَلٌ وَلا الحَذَّاءُ",
      "text": "لَيسَ منَّا المُضَرَّبُونَ وَلا قَيسٌ\nوَلا جَندَلٌ وَلا الحَذَّاءُ",
