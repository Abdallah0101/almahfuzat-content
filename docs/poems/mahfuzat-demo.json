  "chapters": [
    { "id": "opening", "title": "أبيات الاختبار", "number": 1 }
  ],
  "verses": [
    {
      "id": "demo-verse-001",
      "number": 1,
      "first_hemistich": "هَذَا نَصٌّ لِلاخْتِبَارِ الأَوَّلِ",
      "second_hemistich": "يُحْفَظُ فِيهِ الشَّطْرُ وَالتَّشْكِيلُ",
      "text": "هَذَا نَصٌّ لِلاخْتِبَارِ الأَوَّلِ\nيُحْفَظُ فِيهِ الشَّطْرُ وَالتَّشْكِيلُ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-002",
      "number": 2,
      "first_hemistich": "وَهَذَا ثَانِي الأَبْيَاتِ التِّجْرِبِيِّ",
      "second_hemistich": "رَقْمُهُ ثَابِتٌ مَعَ الْمُعَرِّفِ",
      "text": "وَهَذَا ثَانِي الأَبْيَاتِ التِّجْرِبِيِّ\nرَقْمُهُ ثَابِتٌ مَعَ الْمُعَرِّفِ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-003",
      "number": 3,
      "first_hemistich": "وَالثَّالِثُ يُخْتَبَرُ بِالتَّسْجِيلِ",
      "second_hemistich": "ثُمَّ يَبْقَى إِذَا تَغَيَّرَ النَّصُّ",
      "text": "وَالثَّالِثُ يُخْتَبَرُ بِالتَّسْجِيلِ\nثُمَّ يَبْقَى إِذَا تَغَيَّرَ النَّصُّ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-004",
      "number": 4,
      "first_hemistich": "وَالرَّابِعُ فِي قَائِمَةِ الاسْتِمَاعِ",
      "second_hemistich": "يَتْبَعُ صَاحِبَهُ بِغَيْرِ دَمْجٍ",
      "text": "وَالرَّابِعُ فِي قَائِمَةِ الاسْتِمَاعِ\nيَتْبَعُ صَاحِبَهُ بِغَيْرِ دَمْجٍ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-005",
      "number": 5,
      "first_hemistich": "وَالْخَامِسُ يُكْتَشَفُ بِالْبَحْثِ",
      "second_hemistich": "وَالأَصْلُ بِالتَّشْكِيلِ لَا يُبَدَّلُ",
      "text": "وَالْخَامِسُ يُكْتَشَفُ بِالْبَحْثِ\nوَالأَصْلُ بِالتَّشْكِيلِ لَا يُبَدَّلُ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-006",
      "number": 6,
      "first_hemistich": "وَالسَّادِسُ يَعْمَلُ بِغَيْرِ نَتٍ",
      "second_hemistich": "مِنْ ذَاكِرَةِ الْجِهَازِ وَالْمِلْفَاتِ",
      "text": "وَالسَّادِسُ يَعْمَلُ بِغَيْرِ نَتٍ\nمِنْ ذَاكِرَةِ الْجِهَازِ وَالْمِلْفَاتِ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-007",
      "number": 7,
      "first_hemistich": "وَالسَّابِعُ لِلْمُرَاجَعَةِ الْيَوْمِ",
      "second_hemistich": "حَتَّى يَثْبُتَ حِفْظُهُ مَعَ الْوَقْتِ",
      "text": "وَالسَّابِعُ لِلْمُرَاجَعَةِ الْيَوْمِ\nحَتَّى يَثْبُتَ حِفْظُهُ مَعَ الْوَقْتِ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-008",
      "number": 8,
      "first_hemistich": "وَالثَّامِنُ فِي نُسْخَةٍ احْتِيَاطِيَّةٍ",
      "second_hemistich": "تُحْفَظُ خَارِجَ الْمَوْقِعِ الْعَامِّ",
      "text": "وَالثَّامِنُ فِي نُسْخَةٍ احْتِيَاطِيَّةٍ\nتُحْفَظُ خَارِجَ الْمَوْقِعِ الْعَامِّ",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-009",
      "number": 9,
      "first_hemistich": "وَالتَّاسِعُ يُصْدَرُ فِي مِلْفٍ",
      "second_hemistich": "مَعَ إِخْوَتِهِ صَوْتًا مُتَتَابِعًا",
      "text": "وَالتَّاسِعُ يُصْدَرُ فِي مِلْفٍ\nمَعَ إِخْوَتِهِ صَوْتًا مُتَتَابِعًا",
      "chapter_id": "opening"
    },
    {
      "id": "demo-verse-010",
      "number": 10,
      "first_hemistich": "وَالْعَاشِرُ خِتَامُ هَذَا النَّمُوذَجْ",
      "second_hemistich": "لِتُضَافَ بَعْدَهُ أَبْيَاتُ اخْتِبَارٍ",
      "text": "وَالْعَاشِرُ خِتَامُ هَذَا النَّمُوذَجْ\nلِتُضَافَ بَعْدَهُ أَبْيَاتُ اخْتِبَارٍ",
      "chapter_id": "opening"
    }
  ]
}
